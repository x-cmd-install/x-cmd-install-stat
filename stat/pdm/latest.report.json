2c9a2414ae95bf68282d656cf5a9e612c772f007ec5de20527e5","download_count":34,"created_at":"2026-10-30T01:33:18Z","updated_at":"2026-10-30T01:33:19Z"},{"id":690530903,"node_id":"RA_kwDODbsoBs4pKKpX","name":"pdm-2.29.5-x86_64-pc-windows-msvc.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":107,"digest":"sha256:12ebd1c181eae1cb8e0e5362ec48eaf3d466d09b5e7ca01db1427e74d4a7a683","download_count":30,"created_at":"2026-10-30T01:33:18Z","updated_at":"2026-10-30T01:33:18Z"},{"id":690527625,"node_id":"RA_kwDODbsoBs4pKJ2J","name":"pdm-2.29.5-x86_64-unknown-linux-gnu.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":22199380,"digest":"sha256:9fb5ac3e13f3c91e0fad51d91141436e50f687cb42f0b8d5399d2919518e27d4","download_count":82,"created_at":"2026-10-30T01:31:41Z","updated_at":"2026-10-30T01:31:42Z"},{"id":690527624,"node_id":"RA_kwDODbsoBs4pKJ2I","name":"pdm-2.29.5-x86_64-unknown-linux-gnu.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":109,"digest":"sha256:2ff092ef002d191ad95f7add00a33459c40add11ab6426a6165ca47eadb1de87","download_count":72,"created_at":"2026-10-30T01:31:41Z","updated_at":"2026-10-30T01:31:41Z"}],"body":"\n### Bug Fixes\n\n- Preserve archive subdirectories when writing or exporting pylock.toml. ([#3964](https://github.com/pdm-project/pdm/issues/3964))\n- Preserve extras and environment markers on local, URL, Git, and workspace file requirements when translating dependencies for uv. ([#3965](https://github.com/pdm-project/pdm/issues/3965))\n- Preserve Git source subdirectories and encoded refs when generating, reusing, and reading uv lockfiles. ([#3966](https://github.com/pdm-project/pdm/issues/3966))\n- Allow sorting installed packages by optional metadata such as homepage when some values are missing or unknown. ([#3967](https://github.com/pdm-project/pdm/issues/3967))\n- Fill the Homepage in `pdm show` from the `Homepage` Project-URL, and stop `pdm show` failing on a Project-URL that contains a comma. ([#3968](https://github.com/pdm-project/pdm/issues/3968))\n- Quote the activation script path that `pdm venv activate` prints for PowerShell, so `Invoke-Expression (pdm venv activate)` works when the path contains spaces or apostrophes. ([#3970](https://github.com/pdm-project/pdm/issues/3970))\n- On Windows, quote the extra arguments of a `shell` script, and the `{args}` placeholder in it, for `cmd.exe` instead of with POSIX single quotes. ([#3971](https://github.com/pdm-project/pdm/issues/3971))\n- Omit missing package versions when exporting to `pylock.toml`. ([#3972](https://github.com/pdm-project/pdm/issues/3972))\n- Fill the Homepage in `pdm list` from the `Homepage` Project-URL when `Home-page` is missing or unknown. ([#3973](https://github.com/pdm-project/pdm/issues/3973))\n\n\n"}
