te_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":7574016,"digest":"sha256:91793beb5ac9c8df5580612108fc3865b00b259f1b767874e588d8b6513a8bcf","download_count":2,"created_at":"2026-10-09T16:58:44Z","updated_at":"2026-10-09T16:58:45Z"},{"id":625593978,"node_id":"RA_kwDOM7BPMc4lSc56","name":"msb-windows-aarch64.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":38174720,"digest":"sha256:ab148a8a6673b800f054ab4d8bfd926a99a55b6e56d9ea66c9884a3c82089c22","download_count":2,"created_at":"2026-10-09T16:58:44Z","updated_at":"2026-10-09T16:58:47Z"},{"id":625594003,"node_id":"RA_kwDOM7BPMc4lSc6T","name":"msb-windows-x86_64.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":44885504,"digest":"sha256:830da2df0b255da5a219f547799316d90cf829ec85097f937bfa6dbbd47b33a4","download_count":1,"created_at":"2026-10-09T16:58:45Z","updated_at":"2026-10-09T16:58:47Z"}],"body":"<!-- Release notes generated using configuration in .github/release.yml at v0.7.8 -->\n\n## What's Changed\n### Features\n* feat(network): scope secret substitution to specific header fields by @jbms in https://github.com/superradcompany/microsandbox/pull/1639\n* feat(cli): add --mount-disk to msb restore by @0xpolarzero in https://github.com/superradcompany/microsandbox/pull/1733\n* feat(exec): add runtime-owned detached jobs by @appcypher in https://github.com/superradcompany/microsandbox/pull/1774\n* feat(tls): add opt-in application certificate trust helper by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1782\n* feat(cli): support ranges in published ports by @GodBlf in https://github.com/superradcompany/microsandbox/pull/1776\n* feat(snapshot): configure filesystem state limits by @0xpolarzero in https://github.com/superradcompany/microsandbox/pull/1751\n### Fixes\n* fix(db): preserve SQLite locks during Linux identity checks by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1766\n* fix(filesystem): update cached paths after Windows directory renames by @x0day in https://github.com/superradcompany/microsandbox/pull/1769\n* fix(metrics): follow live memory resizes in memory limit and usage by @IIITManjeet in https://github.com/superradcompany/microsandbox/pull/1679\n* fix(network): reject truncated hpack blocks before decoding by @gregwebs in https://github.com/superradcompany/microsandbox/pull/1738\n* fix(storage): repair cleanup and snapshot recovery by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1790\n* fix(runtime): keep the relay running when a local client's arena closes mid-route by @0xpolarzero in https://github.com/superradcompany/microsandbox/pull/1796\n* fix(snapshot): refuse disk restores that would silently drop host mounts by @0xpolarzero in https://github.com/superradcompany/microsandbox/pull/1735\n* fix(storage): finish Windows cleanup and usage accounting by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1797\n* fix(snapshot): allow disk-only restores from snapshot archives by @0xpolarzero in https://github.com/superradcompany/microsandbox/pull/1799\n* fix(ci): repair shared cleanup and managed-job failures by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1806\n### Documentation\n* docs: clarify Rust code readability guidelines by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1794\n### Dependencies\n* chore(deps-dev): bump js-yaml from 4.3.1 to 4.3.2 in /sdk/node-ts in the npm_and_yarn group across 1 directory by @dependabot[bot] in https://github.com/superradcompany/microsandbox/pull/1770\n* chore(deps-dev): bump the npm_and_yarn group across 2 directories with 1 update by @dependabot[bot] in https://github.com/superradcompany/microsandbox/pull/1784\n* chore(deps): Bump the \"dependencies\" group with 2 updates across multiple ecosystems by @dependabot[bot] in https://github.com/superradcompany/microsandbox/pull/1785\n* chore(deps): bump libkrun to 0.1.41 by @toksdotdev in https://github.com/superradcompany/microsandbox/pull/1800\n### Maintenance\n* chore: refresh lockfiles after v0.7.7 by @github-actions[bot] in https://github.com/superradcompany/microsandbox/pull/1768\n* chore(release): bump microsandbox to 0.7.8 by @appcypher in https://github.com/superradcompany/microsandbox/pull/1777\n\n\n**Full Changelog**: https://github.com/superradcompany/microsandbox/compare/v0.7.7...v0.7.8","mentions_count":9}
