29421304,"digest":"sha256:f912d7a3ef6050db80f85e14589a4a14f803cba634215b426c440b9d216f2188","download_count":922,"created_at":"2026-10-12T01:55:55Z","updated_at":"2026-10-12T01:55:57Z"},{"id":632430064,"node_id":"RA_kwDOSPdiBc4lsh3w","name":"DBX_0.6.41_x64-win7-server2012r2-offline-setup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-msdownload","state":"uploaded","size":183224800,"digest":"sha256:dac76b78cbb9e98857c11a58ca868d2bae548907a27fde726c8533c51093c518","download_count":24,"created_at":"2026-10-12T02:32:25Z","updated_at":"2026-10-12T02:32:29Z"},{"id":632430063,"node_id":"RA_kwDOSPdiBc4lsh3v","name":"DBX_0.6.41_x64-win7-server2012r2-offline-setup.exe.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":118,"digest":"sha256:7778103cfbd193754d6b1695ec3f60f903aa6a3da37862a329881c854b2f11b1","download_count":8,"created_at":"2026-10-12T02:32:25Z","updated_at":"2026-10-12T02:32:25Z"},{"id":632416810,"node_id":"RA_kwDOSPdiBc4lseoq","name":"DBX_0.6.41_x64.dmg","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":43309040,"digest":"sha256:33d14bbd9b6409474adec3f19a7d8b807c361b3541491c41aa76a5982d146a31","download_count":29,"created_at":"2026-10-12T02:25:59Z","updated_at":"2026-10-12T02:26:09Z"},{"id":632357413,"node_id":"RA_kwDOSPdiBc4lsQIl","name":"DBX_0.6.41_x64_en-US.msi","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":38465536,"digest":"sha256:84bb6307909d0913ea192a78767c4dd5311461106567ac6437e06b0a93f79616","download_count":51,"created_at":"2026-10-12T01:55:53Z","updated_at":"2026-10-12T01:55:55Z"},{"id":632417234,"node_id":"RA_kwDOSPdiBc4lsevS","name":"DBX_x64.app.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":43233112,"digest":"sha256:8a5e647d479a28d7de2bc6152a2e6a3a421666ac8c8278cbc328b81148c418e0","download_count":58,"created_at":"2026-10-12T02:26:10Z","updated_at":"2026-10-12T02:26:13Z"},{"id":632451390,"node_id":"RA_kwDOSPdiBc4lsnE-","name":"latest.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":17466,"digest":"sha256:46f1aa6d1f4b93a4587dd798b7dc978ffae13be31728f2d0025a39649d2cd4e8","download_count":4437,"created_at":"2026-10-12T02:43:22Z","updated_at":"2026-10-12T02:43:22Z"}],"body":"### 赞助信息\n\n- 赞助伙伴 HiAPI 入驻，提供图片、视频、音频及文本模型 API（GPT Image 2.5 等），新用户注册赠 200 Credits、充值送 10% 积分，[注册入口](https://www.hiapi.ai/invite/dbx?utm_source=dbx&utm_medium=affiliate&utm_campaign=backlink&utm_content=readme-zh)\n\n### 新功能\n\n- 插件商店新增详情浏览、作者筛选以及已安装插件的工作台入口 (contributed by @eryajf) (PR [#11774](https://github.com/t8y2/dbx/pull/11774))\n- 侧边栏新增按列名和注释搜索数据库结构 (contributed by @1gcat) (PR [#11748](https://github.com/t8y2/dbx/pull/11748))\n- SQL 编辑器新增行滚动快捷键、结果集空列隐藏以及多语句执行错误位置映射\n- 结果集筛选取值支持直接从当前页获取候选值 (contributed by @lxk955) (PR [#11739](https://github.com/t8y2/dbx/pull/11739))\n- 数据网格生成值新增「当前日期时间（毫秒）」 (contributed by @HighBigSky) (PR [#11659](https://github.com/t8y2/dbx/pull/11659))\n- 查询结果页签布局优化，并支持鼠标中键关闭 (contributed by @lxk955) (PR [#11744](https://github.com/t8y2/dbx/pull/11744))\n- 侧边栏搜索支持按 Enter 直接打开首个匹配项 (contributed by @yiqiui) (PR [#11746](https://github.com/t8y2/dbx/pull/11746))\n- 复制尚未加载完整的结果集时会给出提示 (contributed by @yiqiui) (PR [#11752](https://github.com/t8y2/dbx/pull/11752))\n- SQL 编辑器支持按名称排除指定自动补全项 (contributed by @yiqiui) (PR [#11751](https://github.com/t8y2/dbx/pull/11751))\n- 新建主键时支持自定义主键名称 (contributed by @yiqiui) (PR [#11768](https://github.com/t8y2/dbx/pull/11768))\n- 索引列选择器中的未选列按字母排序展示 (contributed by @yiqiui) (PR [#11757](https://github.com/t8y2/dbx/pull/11757))\n- SQL 文件执行失败时支持导出和复制失败语句详情 (contributed by @Abeautifulsnow) (PR [#11753](https://github.com/t8y2/dbx/pull/11753))\n- 分组右键菜单支持自定义一级操作和排序 (contributed by @zipg) (PR [#11564](https://github.com/t8y2/dbx/pull/11564))\n- 新增 PackyCode 合作伙伴 AI 服务预设\n\n### 改进\n\n- 索引编辑器渲染与列选项查询性能优化 (contributed by @lxk955) (PR [#11763](https://github.com/t8y2/dbx/pull/11763))\n\n### 修复\n\n- 启用多数据库的 Valkey 集群现在可以正常显示和操作非 db0 的逻辑数据库 (contributed by @CN-Scars) (PR [#11776](https://github.com/t8y2/dbx/pull/11776))\n- Oracle 分组查询不再因注入隐藏 ROWID 导致第二次执行报错 (contributed by @lxk955) (PR [#11775](https://github.com/t8y2/dbx/pull/11775))\n- 修复 OceanBase Oracle 中对包含反斜杠结尾字符串或 q'…' 字面量的查询点击列排序时会追加第二个 ORDER BY 导致报错的问题 (contributed by @Tong-bit-art) (PR [#11771](https://github.com/t8y2/dbx/pull/11771))\n- 达梦、Oracle 与 OceanBase Oracle 的参数替换和变量展开不再误吞数据库链接和 SQL 函数模板 (contributed by @Grapexh) (PR [#11676](https://github.com/t8y2/dbx/pull/11676))\n- PostgreSQL 表结构编辑器支持修改列的标识属性（identity）并生成对应 ALTER 语句 (contributed by @lxk955) (PR [#11756](https://github.com/t8y2/dbx/pull/11756))\n- SQL 风险扫描现在会正确处理 PostgreSQL E'…' 转义字符串 (contributed by @Tong-bit-art) (PR [#11759](https://github.com/t8y2/dbx/pull/11759))\n- SQL 风险扫描现在会扫描 Oracle q'…' 替代引用字符串 (contributed by @Tong-bit-art) (PR [#11762](https://github.com/t8y2/dbx/pull/11762))\n- PostgreSQL/openGauss 历史编码文本解码失败时保留原文并继续查询，不再使整条 SELECT 失败 (contributed by @zipg) (PR [#11647](https://github.com/t8y2/dbx/pull/11647))\n- Oracle JDBC 连接凭据中的特殊字符不再被破坏 (contributed by @zipg) (PR [#11612](https://github.com/t8y2/dbx/pull/11612))\n- 数据网格可预览 Oracle BLOB 单元格中以文本存储的内容 (contributed by @lxk955) (PR [#11750](https://github.com/t8y2/dbx/pull/11750))\n- 通过 JDBC 连接 SQL Server 时，含自定义 schema 的数据库同时列出 dbo 等内置 schema (contributed by @lxk955) (PR [#11077](https://github.com/t8y2/dbx/pull/11077))\n- 传输到 SQL Server 时复用的 DDL 现在会重定向到目标 schema 并修正注释所有者 (contributed by @dienaso) (PR [#11650](https://github.com/t8y2/dbx/pull/11650))\n- DuckDB 多语句拆分不再被 Windows 路径字符串和 E'…' 字符串破坏 (contributed by @onenewcode) (PR [#11652](https://github.com/t8y2/dbx/pull/11652))\n- 以分号结尾的 SQL 中 GROUP BY / ORDER BY 引用投影列别名不再被误报为 Unknown column (contributed by @lxk955) (PR [#11769](https://github.com/t8y2/dbx/pull/11769))\n- 单表导出的默认文件名改用表名 (contributed by @onenewcode) (PR [#11770](https://github.com/t8y2/dbx/pull/11770))\n- Redis 大 Hash 搜索不再因空页提前停止，并可优先返回精确匹配字段 (contributed by @Rendegou) (PR [#11680](https://github.com/t8y2/dbx/pull/11680))\n- 修复 Firebird 表触发器加载和源码查看失败的问题 (contributed by @lxk955) (PR [#11754](https://github.com/t8y2/dbx/pull/11754))\n- 并发创建相同连接池时保留已有连接池，避免重复建连 (contributed by @jeff377) (PR [#11629](https://github.com/t8y2/dbx/pull/11629))\n- MCP 已保存的权限例外在所有连接模式下可见并支持编辑 (contributed by @zipg) (PR [#11618](https://github.com/t8y2/dbx/pull/11618))\n- 复制结果页签时保留独立的筛选与排序规则 (contributed by @zipg) (PR [#11628](https://github.com/t8y2/dbx/pull/11628))\n- 切换 SQL 结果集子页签时保留滚动位置与选中状态 (contributed by @zipg) (PR [#11521](https://github.com/t8y2/dbx/pull/11521))\n- 工具栏关闭「检查更新」后不再显示更新按钮 (contributed by @1gcat) (PR [#11740](https://github.com/t8y2/dbx/pull/11740))\n- Linux 主窗口默认使用不透明背景以避免闪烁和内容消失，透明浮动窗口改为按需开启\n- 侧边栏页签的连接颜色显示对齐 (contributed by @eryajf) (PR [#11766](https://github.com/t8y2/dbx/pull/11766))\n- 备份计划表单滚动时关闭并隐藏游离的连接选择弹层 (contributed by @lxk955) (PR [#11767](https://github.com/t8y2/dbx/pull/11767))\n- Format SQL 没有效果时会说明原因，不再无任何反馈 (contributed by @hongshuo-wang) (PR [#11761](https://github.com/t8y2/dbx/pull/11761))\n- 快捷键设置的冲突角标现在跟随搜索结果统计 (contributed by @Abeautifulsnow) (PR [#11663](https://github.com/t8y2/dbx/pull/11663))\n- 提亮数据网格当前行背景色以提高可见度 (contributed by @peakxy) (PR [#11664](https://github.com/t8y2/dbx/pull/11664))\n\n---\n<!-- dbx-cnb-mirror -->\n> 国内下载：如果 GitHub 下载较慢，可从 [CNB 镜像](https://cnb.cool/dbxio.com/dbx/-/releases/tag/v0.6.41) 下载桌面端安装包，Docker 镜像从 `docker.cnb.cool/dbxio.com/dbx:v0.6.41` 拉取。\n","mentions_count":16}
