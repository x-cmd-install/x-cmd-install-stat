de_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":27763725,"digest":"sha256:67807490e909a37f58ef40b67601896d8d4da2411c9839221dae55732c243fe9","download_count":1019,"created_at":"2026-10-22T21:12:14Z","updated_at":"2026-10-22T21:12:18Z"},{"id":667103698,"node_id":"RA_kwDOBJgEXs4nwzHS","name":"goreleaser_Windows_x86_64.zip.sbom.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":547501,"digest":"sha256:8d0957b9a396b2f6ed77def4d2768ddf8db8d7f250f7550e0e4221e52921df90","download_count":27,"created_at":"2026-10-22T21:12:30Z","updated_at":"2026-10-22T21:12:30Z"}],"body":"\n## Announcement\n\nRead the official announcement: [Announcing GoReleaser v2.19](https://goreleaser.com/blog/goreleaser-v2.19/).\n\n\n## Changelog\n### New Features\n* 35f22818358f56879699906df6a5735cbd2f70e8: feat(archive): configure zstd compression level and window size (#7206) (@caarlos0)\n* 4ebadf5aaeb64dc026be1ea20a4d3afc7673eed0: feat(cask): add hooks install_steps, deprecate raw Ruby hooks (#6873) (@caarlos0)\n* f1e16bfd55e6714e5322eee731d5e2e153835753: feat(ko): support linux_capabilities (#7225) (@mrueg and @caarlos0)\n* 9926ceffa94bb377aac73408872bea632e78032f: feat(nix): drop the nix-hash dependency (#6824) (@caarlos0)\n* 6386def6e6f0da52a0d8fa1dd0a1d81e98f60b8f: feat: graduate stable features out of experimental (#7126) (@caarlos0)\n### Security updates\n* 6ade066121c17e976b77568fb91260424edf719a: sec(deps): bump golang.org/x/ (#7201) (@caarlos0)\n* b690fd89ed2cf418d023293bdb0bb30c8d5fb967: sec: update to Go 1.27.3 (#7220) (@shaanmajid)\n### Bug fixes\n* 09301eaea96eee055c0e992e08f1af841347f71c: fix(archive): propagate tar read errors in Copy (#7194) (@Lzcwbcgs)\n* 68e5e341ab923eac17fb2672259ecb6ab7eefbb3: fix(cask): emit brew-valid casks when builds.ignore drops os/arch combos (#7218) (@Mihir-Rabari)\n* e6c4afca94b5d28e4bbf745ffa43d8b078074fe8: fix(deps): bump moby/sys/user to v0.4.1 (#7202) (@caarlos0)\n* 713c236b9d44de6c7f38717c5785a8d87cf9d8d2: fix(docker): select baseline CPU variants for Docker v2 platforms (#7189) (@zachary-satterly and @caarlos0)\n* 26ffabaa31f962fd11dc479659beb1394e001818: fix(docker/v2): expand global ARG references when resolving the base image (#7203) (@LemonCondor and @caarlos0)\n* 1b7b6a4e99962353e7a1684cb0c7827e79e92404: fix(git): redact credentials from http remote URLs too (#7191) (@Mihir-Rabari)\n* 2d708ed145dd4ecc802588c59df89dee440aaddb: fix(ko): use actual ko version in SPDX SBOM creator (#7226) (@mrueg)\n* 2279d657beafb9fcc269d0f94a9f8233fb434d95: fix: share HTTP client per upload config (#6919) (#7212) (@manish-9245 and @caarlos0)\n* 0c3be4976c17897dd2a6e1ddd581588681fe410d: fix: write cask completion stanzas in Homebrew's order (#7198) (@mustafaakcakaya)\n### Documentation updates\n* d84a6973966c0b1266c6922023472815f545df35: docs: fix broken cosign link in rust-zig blog post (#7228) (@jvS0uzx)\n### Other work\n* ccaac66e8d36f5ce989ea129314af17bc26e650e: chore: auto-update generated files (#7190) (@goreleaserbot)\n* c96c314d896ae3dcd05c64b5ca3ba3ea3ebcb9fc: chore: auto-update generated files (#7200) (@goreleaserbot)\n* 4a71e1e810623c737b663c228f28c7382274c4f7: chore: auto-update generated files (#7204) (@goreleaserbot)\n* b58a06132264e6796ce158380df5866b890b594b: chore: auto-update generated files (#7223) (@goreleaserbot)\n* a9fb415389a2e55906ae457d9f76bb77b3cb6056: chore: auto-update generated files (#7230) (@goreleaserbot)\n\n**Full Changelog**: https://github.com/goreleaser/goreleaser/compare/v2.18.3...v2.19.0\n\n\n## Helping out\n\nThis release is only possible thanks to **all** the support of some **awesome people**!\n\nWant to be one of them?\nYou can [sponsor](https://goreleaser.com/sponsors/), get a [Pro License](https://goreleaser.com/pro) or [contribute with code](https://goreleaser.com/contributing).\n\n## Where to go next?\n\n* Find examples and commented usage of all options in our [website](https://goreleaser.com/intro/).\n* Reach out on [Discord](https://discord.gg/RGEBtg8vQ6), [Twitter](https://twitter.com/goreleaser), and [Telegram](https://t.me/goreleasernews)!\n\n<a href=\"https://goreleaser.com\"><img src=\"https://raw.githubusercontent.com/goreleaser/artwork/master/opencollective-header.png\" with=\"100%\" alt=\"GoReleaser logo\"></a>\n\n\n","reactions":{"total_count":4,"+1":2,"-1":0,"laugh":0,"hooray":2,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":11}
