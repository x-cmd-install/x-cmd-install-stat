RA_kwDOP1JGW84oOA2b","name":"binaries-darwin-arm64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/gzip","state":"uploaded","size":3246331,"digest":"sha256:5b32fc35d9e8b95f74271026bda3cf457acbc93ee5c3f37aa0f73099e846675e","download_count":49,"created_at":"2026-10-25T10:36:15Z","updated_at":"2026-10-25T10:36:16Z"},{"id":674762141,"node_id":"RA_kwDOP1JGW84oOA2d","name":"SHA256SUMS","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":536,"digest":"sha256:847c9296b29e97c71049eb311bcfd821c6823f4d4fc797eea4d2608a46a28339","download_count":620,"created_at":"2026-10-25T10:36:15Z","updated_at":"2026-10-25T10:36:15Z"},{"id":674762147,"node_id":"RA_kwDOP1JGW84oOA2j","name":"status-darwin-amd64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":4410176,"digest":"sha256:9716e7bfc3f2dad72cc71b9e91fd1fca74c90a0b48a005a432f22bd7855b76ab","download_count":166,"created_at":"2026-10-25T10:36:15Z","updated_at":"2026-10-25T10:36:16Z"},{"id":674762134,"node_id":"RA_kwDOP1JGW84oOA2W","name":"status-darwin-arm64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":4268290,"digest":"sha256:f6dc522089e1cceb6d74cefc7eb4c38876ff249f078b781f3f06a4ddfaef4d3b","download_count":455,"created_at":"2026-10-25T10:36:15Z","updated_at":"2026-10-25T10:36:16Z"}],"body":"<div align=\"center\">\n  <img src=\"https://cdn.tw93.fun/pic/cole.png\" alt=\"Mole Logo\" width=\"120\" height=\"120\" style=\"border-radius:50%\" />\n  <h1 style=\"margin: 12px 0 6px;\">Mole</h1>\n  <p><em>Deep clean and optimize your Mac.</em></p>\n</div>\n\n### Changelog\n\n1. Remove more app leftovers with verified ownership: Uninstall now finds additional updater, crash-report, browser integration and sandbox data, while keeping files shared by other installed apps.\n2. Keep game data under your control: `--with-data` leaves game libraries unselected so removing an app does not automatically select its games and saves.\n3. More realistic cleanup estimates: Shared APFS blocks, sparse files and hardlinks no longer inflate the estimated space that cleanup can reclaim.\n4. Protect active caches and project dependencies: Cleanup rechecks whether apps and projects are in use, and keeps dependency folders when it cannot confirm they can be restored.\n5. Slimming respects more app signatures: `mo slim` skips files protected by an enclosing signature and apps explicitly rejected by Gatekeeper, and marks running apps before selection.\n6. Keep unknown battery health unknown: Missing capacity readings no longer produce a Healthy label from a low cycle count, while known battery warnings remain visible.\n\n### 更新日志\n\n1. 卸载能找到更多明确属于应用的残留：补充更新器、崩溃报告、浏览器扩展连接和沙盒数据的识别，同时保留其他已安装应用仍在使用的内容。\n2. 游戏数据由你决定：`--with-data` 不再默认选中游戏库，卸载应用时不会顺带选中其中的游戏和存档。\n3. 清理空间估算更准确：减少 APFS 共享数据块、稀疏文件和硬链接造成的重复估算，让预计可清理空间更接近实际。\n4. 保留正在使用的缓存和项目依赖：清理前再次检查应用与项目是否正在运行，无法确认依赖可以恢复时保留原目录。\n5. 应用瘦身更稳妥：`mo slim` 跳过受外层签名保护的文件和被 Gatekeeper 明确拒绝的应用，并在选择前标出正在运行的应用。\n6. 电池数据缺失时不再误报健康：无法读取容量时，不再仅凭较低的循环次数显示健康，已知的电池警告仍会保留。\n\n### Mole Mac App\n\nIf you would rather work in a window than a terminal, [Mole Mac App](https://mole.fit/) covers cleaning, app removal, maintenance, disk analysis and live status, shows everything before it deletes, and adds tools in the menu bar. It costs $19 once, with free updates and a 14-day refund, and you can [download it here](https://mole.fit/download). The CLI stays free and open source.\n","reactions":{"total_count":7,"+1":2,"-1":0,"laugh":1,"hooray":1,"confused":0,"heart":1,"rocket":1,"eyes":1}}
