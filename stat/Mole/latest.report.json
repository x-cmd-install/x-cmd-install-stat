A_kwDOP1JGW84qQzHI","name":"binaries-darwin-arm64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/gzip","state":"uploaded","size":3250161,"digest":"sha256:34130aec4b24f77f4efa601cb1e96dfd80a90d4d122f0ee393985997fabe9863","download_count":47,"created_at":"2026-11-04T10:02:43Z","updated_at":"2026-11-04T10:02:43Z"},{"id":709046660,"node_id":"RA_kwDOP1JGW84qQzGE","name":"SHA256SUMS","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":536,"digest":"sha256:ca555f86abfcd925c6a8ba573abf7c1653f609484891c2573be0fbb72e7f5020","download_count":942,"created_at":"2026-11-04T10:02:41Z","updated_at":"2026-11-04T10:02:42Z"},{"id":709046666,"node_id":"RA_kwDOP1JGW84qQzGK","name":"status-darwin-amd64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":4414272,"digest":"sha256:f1648c718dbedfb33753da9180ebf2b64f34c672a841f284b7b1617d70f529e7","download_count":167,"created_at":"2026-11-04T10:02:41Z","updated_at":"2026-11-04T10:02:42Z"},{"id":709046671,"node_id":"RA_kwDOP1JGW84qQzGP","name":"status-darwin-arm64","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":4268290,"digest":"sha256:e92ab950e058610af490eaf0045f7509c0b9a9791272968f96fbccbe79d7d985","download_count":765,"created_at":"2026-11-04T10:02:41Z","updated_at":"2026-11-04T10:02:43Z"}],"body":"<div align=\"center\">\n  <img src=\"https://cdn.tw93.fun/pic/cole.png\" alt=\"Mole Logo\" width=\"120\" height=\"120\" style=\"border-radius:50%\" />\n  <h1 style=\"margin: 12px 0 6px;\">Mole</h1>\n  <p><em>Deep clean and optimize your Mac.</em></p>\n</div>\n\n### Changelog\n\n1. Snapshots from other backup apps: Synology Active Backup, Carbon Copy Cloner and similar tools leave APFS snapshots that keep deleted files using space, and `mo clean` now lists them with their owner even on a Mac without Time Machine, while `mo analyze` counts every local snapshot.\n2. Correct app names in uninstall: A hidden `.app` backup no longer shows up in `mo uninstall` under its file name with a leading dot, so the list reads the same whether or not Spotlight indexes the folder.\n3. Sizes at a unit boundary: `mo analyze` shows a file of 999,999 bytes as 1.0 MB, matching Finder, instead of 1000.0 kB.\n4. README in more languages: A Polish copy joins the others, and every README now documents the Linux install command and the timeout tuning variables.\n\n### 更新日志\n\n1. 识别其他备份软件的快照：群晖 Active Backup、Carbon Copy Cloner 这类工具留下的 APFS 快照会让删掉的文件继续占着空间，没开 Time Machine 的 Mac 上 `mo clean` 现在也会列出它们和来源，`mo analyze` 也会统计所有本地快照。\n2. 卸载列表的应用名正确：隐藏的 `.app` 备份在 `mo uninstall` 里不再显示成带点的文件名，Spotlight 有没有索引这个目录，列表都一样。\n3. 单位边界上的大小：`mo analyze` 把 999,999 字节显示成 1.0 MB，和访达一致，不再显示 1000.0 kB。\n4. README 更完整：新增波兰语版本，各语言 README 也补上了 Linux 安装命令和超时调节变量的说明。\n\n### Thanks\n\nIssue reporters and PR contributors this cycle: @chengkangzai · @carlwangx · @kevin9327 · @dkoryto · @jampueroc.\n\n### Mole Mac App\n\nIf you would rather work in a window than a terminal, [Mole Mac App](https://mole.fit/) covers cleaning, app removal, maintenance, disk analysis and live status, shows everything before it deletes, and adds tools in the menu bar. It costs $19 once, with free updates and a 14-day refund, and you can [download it here](https://mole.fit/download). The CLI stays free and open source.\n\n","reactions":{"total_count":10,"+1":3,"-1":0,"laugh":1,"hooray":1,"confused":0,"heart":2,"rocket":2,"eyes":1},"mentions_count":5}
