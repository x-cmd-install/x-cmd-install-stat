nload_count":34,"created_at":"2026-11-20T14:56:17Z","updated_at":"2026-11-20T14:56:18Z"},{"id":772218910,"node_id":"RA_kwDOPFM7E84uByAe","name":"CLIProxyAPI_8.0.80_linux_amd64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":26569442,"digest":"sha256:74ea0252f18f12332d10709d6f196558c72c56429265f05142ab241749a61c16","download_count":1891,"created_at":"2026-11-20T14:56:43Z","updated_at":"2026-11-20T14:56:45Z"},{"id":772217442,"node_id":"RA_kwDOPFM7E84uBxpi","name":"CLIProxyAPI_8.0.80_linux_amd64_no-plugin.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":26424169,"digest":"sha256:e05f968ae36819aeb771fe0f5c9f4110b2a44d8f549a3fdd44e3cb113c00d1a3","download_count":152,"created_at":"2026-11-20T14:56:11Z","updated_at":"2026-11-20T14:56:12Z"},{"id":772225254,"node_id":"RA_kwDOPFM7E84uBzjm","name":"CLIProxyAPI_8.0.80_windows_aarch64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":23943723,"digest":"sha256:d12ed70cf9a9709b5a0d1f8b9affdb5e0252a3387e1bd842e4eeef0744c54bb6","download_count":37,"created_at":"2026-11-20T14:59:00Z","updated_at":"2026-11-20T14:59:01Z"},{"id":772221163,"node_id":"RA_kwDOPFM7E84uByjr","name":"CLIProxyAPI_8.0.80_windows_amd64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":26853669,"digest":"sha256:13d3d9ef6528e5fcfee0d17195936a3332f542d565a96db3f33a9944a57b107f","download_count":995,"created_at":"2026-11-20T14:57:34Z","updated_at":"2026-11-20T14:57:35Z"}],"body":"<!-- cliproxyapi-linux-release-assets:start -->\n## Linux release assets\n\n- `CLIProxyAPI_<version>_linux_<arch>.tar.gz` is the default Linux build. It supports dynamic library plugins and is built against a GLIBC 2.17 baseline.\n- `CLIProxyAPI_<version>_linux_<arch>_no-plugin.tar.gz` is the portable Linux build for musl-based or older systems such as OpenWrt. It does not support dynamic library plugins.\n\n## FreeBSD release assets\n\n- `CLIProxyAPI_<version>_freebsd_aarch64_no-plugin.tar.gz` is the FreeBSD arm64 build. It is built without CGO and does not support dynamic library plugins.\n\n<!-- cliproxyapi-linux-release-assets:end -->\n\n## Changelog\n\n- fix(auth): honor stop rules and retry limits in antigravity credits fallback (a35e8be3)\n- fix(claude): strip foreign advisor blocks after credential rebind (91a3f455)\n- feat(plugin): support credential-scoped after-auth request termination (5bfae629)\n- fix(codex): synthesize baseline model from visible API-supported template and deflake wstunnel auth test (5f7c0553)\n- chore(examples): update moego dependency to v0.1.0-alpha.4 (f19d4a6f)\n- fix(antigravity): align OAuth token refresh transport and User-Agent (0861f9e1)\n- fix(antigravity): bound post-refresh credits warm to prevent goroutine leak and refresh deadlock (99a1c1ca)\n- fix(antigravity): separate 403 probe backoff from token rotation and skip disabled auths (f8e297aa)\n- feat(antigravity): scope synthesized request.sessionId per credential (3a24d03c)\n- fix(gemini): cap Gemini 4 max completion tokens at 65536 (c1040cc0)\n- fix(executor): ignore Claude Code attribution block in reasoning replay lane (bba22ed9)\n- fix(api): decode gzip request bodies and honor Content-Encoding on Claude routes (6e7a1b29)\n- fix(auth): stop credential loop on cancellation during auth preparation and Home execution (dfdb3ba4)\n- fix(auth): enforce consistent cancellation and Retry-After cooldown handling (3ad507bf)\n- fix(auth): preserve streamResult.Headers on invalid-request bootstrap errors and avoid double-wrapping streamBootstrapError (d52047a6)\n- fix(auth): classify anthropic stop_reason consistently for message and message_delta payloads (3a0d3023)\n- fix(auth): end home selection on empty stream and drain upstream chunks on cancel (9be2d5f1)\n- fix(auth): align executeHome and executeHomeOnce with execution-path parity (84e0cd9b)\n- fix(auth): clone metadata before interceptor session updates and publish refreshed auth on 401 retry (2dbad4dd)\n- fix(meta): synthesize unstreamed Responses messages and translate refusal parts (ca459712)\n- fix(meta): tighten Responses output synthesis tracking and refusal fallbacks (e442c32d)\n- test(meta): add regression coverage for incomplete synthesis and refusal fallbacks (2e940ba1)\n- fix(auth): honor request-scoped-errors, Retry-After, and credential scope on PrepareRequestAuth failure (2f57a5a6)\n- fix(auth): serialize request auth preparation with refresh locks and abort unregistered credentials (0a34244e)\n- fix(auth): scope stream bootstrap retry-after annotation to the same upstream attempt (d4f6edb1)\n- fix(auth): publish selected auth metadata only after executable model check (0399de38)\n- fix(auth): capture per-attempt access token on streaming failure results (f5c5681a)\n\n\n**Full Changelog**: https://github.com/router-for-me/CLIProxyAPI/compare/v8.0.79...v8.0.80\n","reactions":{"total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0}}
