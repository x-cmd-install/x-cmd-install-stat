ic","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":94,"digest":"sha256:4b90f441acac4249078c48abc1222f3f742c0381fdb038d26e42359b47976218","download_count":504,"created_at":"2026-10-15T12:44:33Z","updated_at":"2026-10-15T12:44:33Z"},{"id":643844794,"node_id":"RA_kwDOR_sfj84mYEq6","name":"latest-linux-arm64.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":389,"digest":"sha256:0f5209ff57af790688f6bbdf32e82328f47cfaee192077a41093d2ced04c56b8","download_count":28,"created_at":"2026-10-15T12:46:08Z","updated_at":"2026-10-15T12:46:08Z"},{"id":643850170,"node_id":"RA_kwDOR_sfj84mYF-6","name":"latest-linux.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":391,"digest":"sha256:28488029e32bf4e604b325817ab7f60c7a56358d402ec53194a039068cdd6ac7","download_count":169,"created_at":"2026-10-15T12:48:15Z","updated_at":"2026-10-15T12:48:15Z"},{"id":643868456,"node_id":"RA_kwDOR_sfj84mYKco","name":"latest-mac.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":827,"digest":"sha256:d32a6fc91457b2f02a03e61a571eb35cf0107a0c7b9512fd587299f72ec978f6","download_count":1723,"created_at":"2026-10-15T12:55:16Z","updated_at":"2026-10-15T12:55:16Z"},{"id":643851886,"node_id":"RA_kwDOR_sfj84mYGZu","name":"latest.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":350,"digest":"sha256:67b5719e097ae0137d7e08f19ce5bc5db0e8f1421359ff8ab09c5a25ed726ffe","download_count":4313,"created_at":"2026-10-15T12:48:58Z","updated_at":"2026-10-15T12:48:58Z"}],"body":"## 更新重点\n\n- 新增主题实时自定义，可按界面区域设置背景、透明度、模糊、圆角、边框和阴影，并支持命名主题、复制、切换及账号保存 (#3394)。\n- 完善 GIF、动态 WebP 和 APNG 壁纸支持，壁纸上限提升至 **30 MB**，主题 ZIP 上限提升至 **32 MB**；上传、缓存、导入和导出均保留动画 (#3399)。\n- 修复小屏下工作流执行记录抽屉宽度不足和背景透明的问题 (#3398)。\n- 修复群聊 AI 消息主题同步，消除消息气泡及表格中的重复背景和模糊 (#3398)。\n- 统一模型可见性设置在模型选择器中的生效范围，并为大型模型目录增加性能提示 (#3392)。\n- 可见模型管理新增搜索功能 (#3393)。\n- Provider 完整模型目录改为按需加载，减少配置页的首次请求量 (#3401)。\n- 将新建聊天的分类选择移至输入框工具栏 (#3389)。\n- 完善 Windows 盘符根目录工作区处理，并保留文件路径中的首尾空格 (#3396)。\n- 修复带版本标记的 Hermes Runtime 打包兼容性 (#3400)。\n- 新增随版本发布自动构建和校验 TOS 7 x86_64 测试安装包的流程 (#3397)。\n- Studio 与桌面端版本同步更新为 `0.7.36`，前端更新日志覆盖 12 种语言并保留最近三个版本 (#3399)。\n\n## What's Changed\n* [codex] honor model visibility and warn about large catalogs by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3392\n* [codex] add search to visible model management by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3393\n* [codex] move new-chat category picker into composer toolbar by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3389\n* [codex] add live theme customization and portable theme presets by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3394\n* [codex] build TOS 7 packages automatically on release publication by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3397\n* [codex] fix workflow drawers and chat message themes by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3398\n* [codex] complete Windows drive-root workspace handling without trimming file paths by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3396\n* [codex] package Hermes releases with install-stamp version identity by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3400\n* [codex] prepare 0.7.36 with 30 MB animated wallpapers by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3399\n* [codex] load full provider model catalogs on demand by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3401\n\n\n**Full Changelog**: https://github.com/EKKOLearnAI/ekko-studio/compare/v0.7.35...v0.7.36\n","mentions_count":2}
