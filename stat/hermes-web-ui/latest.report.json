ew_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":354,"digest":"sha256:6c4d9244575cfbb99b7e0dbf447acf07169d2c064de56b0fc4c3209ab6de1355","download_count":15,"created_at":"2026-10-20T10:11:35Z","updated_at":"2026-10-20T10:11:36Z"},{"id":658932073,"node_id":"RA_kwDOR_sfj84nRoFp","name":"latest-linux-arm64.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":389,"digest":"sha256:f349dad654eec34b5237311d7e8e09ea793febd0494f80ed45142ce1852edbf9","download_count":32,"created_at":"2026-10-20T09:57:00Z","updated_at":"2026-10-20T09:57:00Z"},{"id":658938034,"node_id":"RA_kwDOR_sfj84nRpiy","name":"latest-linux.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":391,"digest":"sha256:7a6d3cbbaafa75504e38364503d930c37d6988a31a6bd223a811d02d12936ad7","download_count":234,"created_at":"2026-10-20T09:59:47Z","updated_at":"2026-10-20T09:59:47Z"},{"id":658966157,"node_id":"RA_kwDOR_sfj84nRwaN","name":"latest-mac.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":827,"digest":"sha256:b727c5eb84c3210335b21a49c5c359fc6686e4420860b2ad9d3c6f0c9853cfa5","download_count":1957,"created_at":"2026-10-20T10:12:17Z","updated_at":"2026-10-20T10:12:17Z"},{"id":658936545,"node_id":"RA_kwDOR_sfj84nRpLh","name":"latest.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":350,"digest":"sha256:9ea622d123712e454eceb8bff4a650c5f86b9cca36e885603a65a746cff91609","download_count":5561,"created_at":"2026-10-20T09:59:08Z","updated_at":"2026-10-20T09:59:08Z"}],"body":"## 更新重点\n\n- 新增自动 API 模式，可按已知连接和模型匹配协议，兼容带服务商前缀的模型名称；新建连接仍默认 Chat Completions (#3469)\n- 桌面端新增本机与远程设备切换和设备管理，替换旧的局域网配对入口 (#3464)\n- 模型 API 新增云端访问、密钥可用模型限制和累计美元预算，恢复 Agent 用量细分，并修复面板宽度 (#3440、#3450)\n- 支持通过桌面端和网页链接导入服务商，导入前可确认并补全连接信息 (#3438)\n- Ekko 电脑操作新增可选的 JEV 元素语义匹配与结果验证，可分别开启或关闭 (#3463)\n- 内置浏览器的新建配置默认使用系统代理，减少连接配置步骤 (#3455)\n- 修复 DSH ACP 0.2.1 的对话轮次保存兼容性，确保回复结束后正确保存会话 (#3452)\n- 聊天附件改为按实际运行的 Profile 校验权限，修复切换 Profile 后的附件鉴权错误 (#3439)\n- 完善 TOS 7 安装、升级、卸载和反向代理入口，新增隐私政策入口并更新存在漏洞的依赖 (#3466)\n- 新增 M5Stack Cardputer-Adv 局域网固件开发预览，支持文字与短语音聊天，供已有兼容分区布局的设备手动升级 (#3451)\n- Studio 与桌面端版本同步更新为 `0.7.38`，前端更新日志覆盖 12 种语言并保留最近三个版本 (#3472)。\n\n## What's Changed\n\n* fix(chat): authorize attachment runs against their resolved profile by @widechaos in https://github.com/EKKOLearnAI/ekko-studio/pull/3439\n* feat(esp32-s3): add M5Stack Cardputer-Adv LAN firmware preview by @thursdaycapital in https://github.com/EKKOLearnAI/ekko-studio/pull/3451\n* [codex] make Model API panel fill available width by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3450\n* [codex] fix DSH ACP 0.2.1-rc.2 turn persistence compatibility by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3452\n* feat(models): import providers through desktop and web links by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3438\n* fix: use system proxy by default for browser profiles by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3455\n* [codex] add JEV matching and verification to Ekko Computer Use by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3463\n* [codex] add cloud Model API access, key controls and Agent usage by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3440\n* [codex] add desktop device switching and retire LAN pairing by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3464\n* [codex] wait for device Close button before native pointer test by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3468\n* fix(tos): remediate review lifecycle and package compliance findings by @wtj-0527 in https://github.com/EKKOLearnAI/ekko-studio/pull/3466\n* Add automatic API mode and match namespaced model IDs by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3469\n* chore: prepare Studio 0.7.38 with localized changelog by @EKKOLearnAI in https://github.com/EKKOLearnAI/ekko-studio/pull/3472\n\n\n**Full Changelog**: https://github.com/EKKOLearnAI/ekko-studio/compare/v0.7.37...v0.7.38\n","mentions_count":4}
