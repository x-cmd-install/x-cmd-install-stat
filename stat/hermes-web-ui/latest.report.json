ic","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":354,"digest":"sha256:5486324bc064a647de2f87712b02818402a14ec0dbe951c7edd8a140dc6614f7","download_count":4,"created_at":"2026-11-20T01:06:07Z","updated_at":"2026-11-20T01:06:07Z"},{"id":769895069,"node_id":"RA_kwDOR_sfj84t46qd","name":"latest-linux-arm64.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":389,"digest":"sha256:2e11d1f3bbc8c7a7c3b9482e5dd1f99a5b8b1c75e32eddc5de393a9af9a60dd5","download_count":10,"created_at":"2026-11-20T00:55:05Z","updated_at":"2026-11-20T00:55:06Z"},{"id":769899554,"node_id":"RA_kwDOR_sfj84t47wi","name":"latest-linux.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":391,"digest":"sha256:33bf4a4c90e2f8288967f179535b4e63d852db13f869706d99497f0a5b31fec2","download_count":45,"created_at":"2026-11-20T00:56:46Z","updated_at":"2026-11-20T00:56:46Z"},{"id":769925469,"node_id":"RA_kwDOR_sfj84t5CFd","name":"latest-mac.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":827,"digest":"sha256:6125491174e0930befa4fd7a820222b80d591e87baf3c7c9e8930e20be128642","download_count":273,"created_at":"2026-11-20T01:06:50Z","updated_at":"2026-11-20T01:06:50Z"},{"id":769900325,"node_id":"RA_kwDOR_sfj84t478l","name":"latest.yml","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/yaml","state":"uploaded","size":350,"digest":"sha256:b2552b5db55021aa1591844a5a02b30b1f18d9f8ec6c70f65b3fab8b0ab6e2c4","download_count":1072,"created_at":"2026-11-20T00:57:07Z","updated_at":"2026-11-20T00:57:08Z"}],"body":"# Studio 0.8.29\n\n本版基于 `3fac62347eeb7157f54a0f69977aa5324b94d0a3`，上一正式版为 `v0.8.28`。\n\n- 聊天中的审批和澄清提交后会收到确认。Studio 右上角可处理账号关联的各个 Profile 的聊天审批、澄清及工作流审批，并在重新连接后刷新待处理请求。 (#3886)\n- 插件中心新增第三方插件风险提示。启用时会提示确认，安装、更新或切换来源时会显示可用的作者和仓库信息，并提示已启用的插件可能立即运行新版代码。 (#3879)\n- Person 的后台任务结果会在所依赖的其他任务处理完后继续回传。Studio 重启后可恢复等待中的结果，重试时会避免重复回传。 (#3869)\n- 修复 Agent 管理因单个插件状态检查卡住而无法加载的问题。新建单聊时，即使可用性还在检查或检查失败，仍可选择内置 Ekko。 (#3874)\n- 修复群聊中 Agent 交接后可能无法使用已配置 Provider 的问题。Hermes 和 Ekko 接手时会按发起者账号和接收 Agent 的 Profile 查找模型。 (#3875)\n- 审批 Hermes 记忆写入时，按当前 Profile 的记忆配置检查容量限制和启用状态。 (#3872)\n- 修复 Hermes 执行进程已退出时，重新连接会话可能误报失败的问题。查询会话状态时也会避免启动已退出的进程。 (#3867)\n- 修复 Hermes 通过 Amazon Bedrock 连接模型时，可能因 TLS 初始化顺序而无法建立 HTTPS 连接的问题。 (#3878)\n\n本版经发版 PR #3887 合入。\n"}
