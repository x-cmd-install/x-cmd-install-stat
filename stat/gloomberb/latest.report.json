682c16790","download_count":1,"created_at":"2026-10-20T12:30:13Z","updated_at":"2026-10-20T12:30:29Z"},{"id":659275146,"node_id":"RA_kwDORwA07s4nS72K","name":"stable-win-x64-Gloomberb.tar.zst","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":314168812,"digest":"sha256:c1233e6f524228e17b591e3d05815be82fee1ef816d8257bf70ae47b403382d2","download_count":10,"created_at":"2026-10-20T12:30:13Z","updated_at":"2026-10-20T12:30:29Z"},{"id":659275118,"node_id":"RA_kwDORwA07s4nS71u","name":"stable-win-x64-GloomberbSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-msdos-program","state":"uploaded","size":291519160,"digest":"sha256:7c348d56b981903abf474d6b2df0bea4cd548ef25cad943acc0b3787f6ef2879","download_count":197,"created_at":"2026-10-20T12:30:13Z","updated_at":"2026-10-20T12:30:30Z"},{"id":659275130,"node_id":"RA_kwDORwA07s4nS716","name":"stable-win-x64-update.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":73,"digest":"sha256:6b8c33f4dddb999dbce72f4ffe69185980a7f9f8329b972fd5b68f9ed0be32ff","download_count":55,"created_at":"2026-10-20T12:30:13Z","updated_at":"2026-10-20T12:30:13Z"}],"body":"## Highlights\n\n- **Both crosshair lines are back.** The chart under the pointer shows the horizontal line and its price again, and resting charts such as Inventories now follow the pointer. (#2010)\n- **Reconnect a broker from the portfolio.** An offline broker's positions say when they last synced and why, and `b` reconnects it. (#2011)\n- **Portfolios in other currencies.** `PORT` Risk, Factors, Correlation and Stress work for an account that is not in USD, and a position bought in another currency takes a purchase date or cost FX rate, so P&L shows the currency move. (#2004, #2007)\n\n## Also in this release\n\n- `EXEC` shows each executive's total pay and `MOST` lists pre-market and after-hours movers on every plan. (#2015)\n- `PORT` and `MARS` add a quality factor (QUAL - SPY), and `catalog style` finds it. (#2006)\n- Pasted ticker lists read every cell and name the ones that need a choice. (#2005)\n- Turkish CPI in `econ --country TR` and as a series. (#2009)\n- Quick Notes no longer saves a new index over one it could not read, and `notes export` writes your Cloud notes and says what it skipped. (#1998, #1999)\n- The Team pane says when invitations fail to load instead of showing none. (#2000)\n\n[Full diff](https://github.com/gloom-sh/gloomberb/compare/v0.18.0...v0.18.1)\n"}
