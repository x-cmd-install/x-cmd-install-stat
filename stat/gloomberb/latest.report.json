:37Z","updated_at":"2026-11-16T05:56:37Z"},{"id":753660873,"node_id":"RA_kwDORwA07s4s6_PJ","name":"stable-win-x64-update.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":200,"digest":"sha256:8106c0b9f0a4e31bc6a1cbdcc6f4f9de3564cfc87a3bf2fda427367ee32e2d6a","download_count":177,"created_at":"2026-11-16T05:56:37Z","updated_at":"2026-11-16T05:56:37Z"},{"id":753660855,"node_id":"RA_kwDORwA07s4s6_O3","name":"stable-win-x64-update.json.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":93,"digest":"sha256:9ac160a9533363060a8760fc02a77be2d85050d1042a1109730b53c18b1e9423","download_count":2,"created_at":"2026-11-16T05:56:37Z","updated_at":"2026-11-16T05:56:37Z"}],"body":"## Highlights\n\n- **Award amounts follow the rows on screen.** The default `AWARDS` feed no longer shows Obligated and Ceiling as columns of dashes: each amount column shows while a row in view reports it and comes back when you scroll to one, and exports keep every amount. (#2768)\n- **Earnings moves on past reports.** `EVTS` shows each report's realized move once it is out, not only on the day, and leaves out IMPLIED, MOVE and AVG MOVE while no row in view has them. (#2771)\n- **Stalled sources say so in seconds.** Treasury cash (`DTS`) and auctions (`AUCT`) report a stalled source within seconds instead of after a minute, and the `CALLS` list stops waiting after 20 s. (#2771)\n- **Economic exports keep their notes.** Economic data exports credit each series' original publisher and keep source notes and caveats in one CSV, whether written to a file or piped. (#2763)\n\n## Also in this release\n\n- Company comparison charts keep the metric's name in a compact legend (`GF`, `CMP`). (#2767)\n- `SIW` says why a ticker has no short interest on that ticker's own row. (#2767)\n- ADR vs Home in `DES` uses the quote its pane already shows for the home listing when a second read comes back empty. (#2771)\n- `ECST` keeps small housing moves and shows years with matching chart units, and time and sales labels a closed market's last session. (#2763)\n\n[Full diff](https://github.com/gloom-sh/gloomberb/compare/v0.20.16...v0.20.17)\n"}
