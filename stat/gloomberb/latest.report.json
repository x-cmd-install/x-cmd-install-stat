d3a070","download_count":0,"created_at":"2026-10-15T21:28:27Z","updated_at":"2026-10-15T21:28:40Z"},{"id":645223232,"node_id":"RA_kwDORwA07s4mdVNA","name":"stable-win-x64-Gloomberb.tar.zst","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":312748237,"digest":"sha256:56691123c9714641e8388e664558df171ba66edb30ec679c11bb072a5532a091","download_count":1,"created_at":"2026-10-15T21:28:27Z","updated_at":"2026-10-15T21:28:39Z"},{"id":645223226,"node_id":"RA_kwDORwA07s4mdVM6","name":"stable-win-x64-GloomberbSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-msdos-program","state":"uploaded","size":290146267,"digest":"sha256:e71751a829dd9a9b8f61b95dcb1f4a1ea8ba48f62c7ff31d3c32b39be9028358","download_count":30,"created_at":"2026-10-15T21:28:27Z","updated_at":"2026-10-15T21:28:38Z"},{"id":645223223,"node_id":"RA_kwDORwA07s4mdVM3","name":"stable-win-x64-update.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":73,"digest":"sha256:1e552f0314e2fa9677e59275371ec8a8196870acd0955adb5f8de97e623eae3a","download_count":7,"created_at":"2026-10-15T21:28:27Z","updated_at":"2026-10-15T21:28:27Z"}],"body":"## Highlights\n\n- **Chat keeps up with your typing.** Typing or attaching an image no longer redraws the whole conversation, so long channels stop stalling while you write. (#1845)\n- **Report a bug from the pane it happens in.** `Report a Bug` in any pane's menu pictures the pane, adds the app version, and posts it with your note to #bugs. (#1843)\n- **A Dock badge worth checking.** On the Mac it counts the people who wrote to you and mentions of you, not every unread channel message. (#1842)\n- **Quieter pane footers.** `[i] compose` and the sidebar `[<]` `[>]` hints are gone; the keys still work and the pane menu lists them. (#1827)\n\n## Also in this release\n\n- `CTM` turns up for basis, carry and contango searches, `PERP` accepts names like bitcoin or brent, and the glossary explains basis and contango. (#1834)\n- Opening a crypto board row such as Zcash works again, and a failed open says why. (#1844)\n- BI Sector Performance shows every sector fund's price before the open. (#1841)\n- A panned dataset chart such as `CHOKE` stays loaded to its newest data. (#1846)\n- Index quotes say pre-market with the opening time, like stocks. (#1849)\n- `MDAY` counts a new CPI or jobs report day as soon as it is out. (#1850)\n- Missing currencies, open interest and Kelly payoffs stay blank instead of USD or zero, and `13F` lists funds sooner. (#1836, #1838, #1837, #1839)\n\n[Full diff](https://github.com/gloom-sh/gloomberb/compare/v0.17.4...v0.17.5)\n"}
