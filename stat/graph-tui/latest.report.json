d_at":"2026-11-10T07:20:13Z","updated_at":"2026-11-10T07:20:13Z"},{"id":730500729,"node_id":"RA_kwDOVeNBwM4rio55","name":"graph-tui-x86_64-unknown-linux-gnu.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":1170994,"digest":"sha256:41fa510a7da7c56d0ebdcd21df5475833eaa92db65839a6a07cf59bb11233203","download_count":4,"created_at":"2026-11-10T07:20:13Z","updated_at":"2026-11-10T07:20:13Z"},{"id":730505061,"node_id":"RA_kwDOVeNBwM4rip9l","name":"graph-tui-x86_64-unknown-linux-musl.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":109,"digest":"sha256:6efe99aa38d57b5435ba00340661263bef23886427389cc3a29d9498184ba66d","download_count":3,"created_at":"2026-11-10T07:21:55Z","updated_at":"2026-11-10T07:21:55Z"},{"id":730505058,"node_id":"RA_kwDOVeNBwM4rip9i","name":"graph-tui-x86_64-unknown-linux-musl.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":1226054,"digest":"sha256:18bfa7904616a131f0b10be110829fff18d166dbc1eb03ea09a5e7ab7a4c7fc7","download_count":3,"created_at":"2026-11-10T07:21:55Z","updated_at":"2026-11-10T07:21:56Z"}],"body":"`.gtui` format 10 (reads v1..v10). Crate 0.15.1.\n\n\n### Fixed\n\n- A zero-byte `.gtui` opens as a new document instead of failing with `json: byte 0: unexpected\n  end of input`. `touch empty.gtui && graph-tui empty.gtui` now behaves like `nvim`: empty buffer,\n  `:w` writes it. Any empty file (not just `.gtui`) is treated the same way, and `--dump` of one\n  prints the blank document rather than an error.\n\n- Editing text in place with double-width characters no longer swallows them. The draft was written\n  one character per cell, so each CJK character's right half was overwritten by the next one; the\n  caret column was counted in characters as well, so it drifted half a cell per wide character.\n  Both now use display width: wide characters occupy two cells (the second is a blank continuation,\n  like the static text path), and `Up` / `Down` keep the column in cells, landing on the character\n  boundary at or before it -- the same rule nvim uses.\n\n"}
