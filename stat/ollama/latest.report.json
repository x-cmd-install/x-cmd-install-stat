1-03T06:47:45Z","updated_at":"2026-11-03T06:47:52Z"},{"id":704621712,"node_id":"RA_kwDOJ0Z1Ps4p_6yQ","name":"OllamaSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1675999728,"digest":"sha256:e069c7cc7d4808f77684e81efa0b1f853a5190b4b8f070bc8fd63041180e3eba","download_count":211248,"created_at":"2026-11-03T06:47:44Z","updated_at":"2026-11-03T06:48:44Z"},{"id":704624569,"node_id":"RA_kwDOJ0Z1Ps4p_7e5","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:b734a33b36ff80f447517f6217d054084e0eca552bb81a0a26e2d4e17194b4dc","download_count":2941,"created_at":"2026-11-03T06:48:56Z","updated_at":"2026-11-03T06:48:56Z"}],"body":"## What's Changed\r\n* `ollama launch claude` now applies the model's output token limit for Claude Code, so cloud models no longer run into the 128k default cap\r\n* Cloud web search responses on `/api/chat` are now decoded correctly, including compressed responses\r\n* OpenAI-compatible endpoints no longer override a model's packaged sampler defaults — clients that send no `temperature`/`top_p` get the model's own values instead of 1.0, matching `/api/chat`\r\n* `/v1/responses` now preserves readable input content, including prior assistant refusals, instead of flattening it\r\n* Ollama's app can now retry ChatGPT disconnect failures instead of leaving the connection in a broken state\r\n* `ollama launch codex` verifies ChatGPT routing before configuring, and reports a clear error when routing is unavailable\r\n* Faster top-k sampling on MLX for large vocabularies\r\n\r\n**Full Changelog**: https://github.com/ollama/ollama/compare/v0.40.13...v0.40.14","reactions":{"total_count":21,"+1":15,"-1":0,"laugh":0,"hooray":1,"confused":0,"heart":2,"rocket":3,"eyes":0}}
