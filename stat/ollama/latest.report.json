at":"2026-10-21T03:53:45Z"},{"id":661282666,"node_id":"RA_kwDOJ0Z1Ps4nal9q","name":"OllamaSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1657983656,"digest":"sha256:6394e61daedc2de736c9f76cbc58f30f9241ba1eb4c2f79ef75e833168db8a60","download_count":7632,"created_at":"2026-10-21T03:53:38Z","updated_at":"2026-10-21T03:54:30Z"},{"id":661284123,"node_id":"RA_kwDOJ0Z1Ps4namUb","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:1c560fd7c0da7b98e0fe2c2fe4f17d31159fa4e6b4d86153afc080c1663d7dbb","download_count":108,"created_at":"2026-10-21T03:54:31Z","updated_at":"2026-10-21T03:54:31Z"}],"body":"## What's Changed\r\n* [pplx-decider](https://ollama.com/library/pplx-decider) is a 27B decision model from Perplexity, fine-tuned from\r\nQwen3.8-27B\r\n* Continuing an OpenAI-compatible Responses conversation no longer fails when switching between models with and without\r\nthinking, or when the history contains another provider's compaction items\r\n* Fixed streaming Responses requests where client tool calls (e.g. Codex with web search) could emit before open\r\nreasoning items, producing misordered/duplicate tool call events\r\n* Requests routed to remote models are now cancelled on ollama.com when the client disconnects, instead of continuing\r\nto run\r\n* `ollama show` now reports which renderer and parser a model uses and where its chat template comes from; the API\r\nexposes the same values in new `renderer`, `parser`, and `template_source` fields\r\n* More draft models now work with speculative decoding: llama-server infers the draft type automatically instead of\r\nrequiring Ollama to identify it\r\n* `ollama launch claude` now clamps `CLAUDE_CODE_AUTO_COMPACT_WINDOW` to Claude Code's supported range, avoiding a\r\n\"window too large\" warning\r\n* Updated llama.cpp and MLX\r\n\r\n**Full Changelog**: https://github.com/ollama/ollama/compare/v0.40.6...v0.40.7","reactions":{"total_count":29,"+1":18,"-1":0,"laugh":0,"hooray":4,"confused":0,"heart":1,"rocket":6,"eyes":0}}
