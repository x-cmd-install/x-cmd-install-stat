26-10-24T17:27:57Z","updated_at":"2026-10-24T17:28:04Z"},{"id":672867058,"node_id":"RA_kwDOJ0Z1Ps4oGyLy","name":"OllamaSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1662012016,"digest":"sha256:87309d23b423abeae1d8df2f98df95f94bf35659debfdf3761d65b7b62a75508","download_count":526734,"created_at":"2026-10-24T17:27:56Z","updated_at":"2026-10-24T17:28:46Z"},{"id":672868924,"node_id":"RA_kwDOJ0Z1Ps4oGyo8","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:c020ec823b5652daf0d4dfc2b35a2365d9bb0fe4318debe6eb8a64ab2d147889","download_count":6619,"created_at":"2026-10-24T17:28:54Z","updated_at":"2026-10-24T17:28:55Z"}],"body":"## Speech\r\n\r\nOllama can now generate [speech](https://docs.ollama.com/capabilities/speech) on macOS. `ollama run` plays text or a chat model's reply aloud as the audio is generated, and apps can stream audio through the OpenAI-compatible `/v1/audio/speech` endpoint.\r\n\r\n```sh\r\nollama run phonon \"Hello from Ollama.\"\r\n```\r\n\r\n## d3 decision models\r\n\r\n[d3](https://ollama.com/library/d3) brings vLLM Semantic Router's decision models to Ollama. Give a model text, structured state, or an image, and ask it to classify, answer yes or no, or score options with probabilities. The family includes 2B, 4B, 9B, and 27B sizes.\r\n\r\n```sh\r\nollama run d3 \"A customer says their card was charged twice.\" --ask \"Is this a billing issue?\"\r\n```\r\n\r\n## New Contributors\r\n* @SynapShift made their first contribution in https://github.com/ollama/ollama/pull/19173\r\n\r\n**Full Changelog**: https://github.com/ollama/ollama/compare/v0.40.10...v0.40.11","reactions":{"total_count":32,"+1":18,"-1":0,"laugh":2,"hooray":0,"confused":0,"heart":2,"rocket":10,"eyes":0},"mentions_count":1}
