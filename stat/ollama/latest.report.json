27:59Z","updated_at":"2026-10-06T18:28:05Z"},{"id":616313777,"node_id":"RA_kwDOJ0Z1Ps4kvDOx","name":"OllamaSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1578287264,"digest":"sha256:135bf4d927b1de03e884cd2fe66729bdf4d6a2983c5a453b99eb403489e460e1","download_count":85424,"created_at":"2026-10-06T18:27:58Z","updated_at":"2026-10-06T18:29:01Z"},{"id":616316119,"node_id":"RA_kwDOJ0Z1Ps4kvDzX","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:1d6f1352096e58c558d159e20829aa87eb86ab99c771298630573d738832029f","download_count":605,"created_at":"2026-10-06T18:29:02Z","updated_at":"2026-10-06T18:29:02Z"}],"body":"## What's Changed\r\n\r\n**Models run on MLX on Apple Silicon by default**\r\n\r\nIn this release, on Apple Silicon devices, model architectures supported by the MLX runtime will automatically run on MLX.\r\n\r\n```\r\nollama pull qwen3.8\r\nollama run qwen3.8\r\n```\r\n\r\nAdditional models include [gemma4](https://ollama.com/library/gemma4), [qwen3.6](https://ollama.com/library/qwen3.6) and [qwen3.5](https://ollama.com/library/qwen3.5)\r\n\r\nDecision models are now available on MLX as well: [Nimble](https://ollama.com/library/nimble) [tev1](https://ollama.com/library/tev1)  [clef](https://ollama.com/library/clef) [clef-flash](https://ollama.com/library/clef-flash) \r\n\r\nMLX now has support for an embedding model: [embeddinggemma-2](https://ollama.com/library/embeddinggemma-2)\r\n\r\nWe will continue testing and enabling additional models.\r\n\r\n\r\n**Full Changelog**: https://github.com/ollama/ollama/compare/v0.35.1...v0.40.0","reactions":{"total_count":68,"+1":29,"-1":0,"laugh":5,"hooray":7,"confused":0,"heart":9,"rocket":13,"eyes":5}}
