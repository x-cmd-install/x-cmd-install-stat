-10-02T17:10:24Z","updated_at":"2026-10-02T17:10:29Z"},{"id":606088617,"node_id":"RA_kwDOJ0Z1Ps4kIC2p","name":"OllamaSetup.exe","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1580352416,"digest":"sha256:2544c6dc60c57866f5cfbd32b8f7c5ffa5e1f7f0579ca59da5ff20bdc53ad3d2","download_count":612541,"created_at":"2026-10-02T17:10:23Z","updated_at":"2026-10-02T17:11:12Z"},{"id":606090067,"node_id":"RA_kwDOJ0Z1Ps4kIDNT","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:f0066986be55a993493ec508e3844e3310c0a5fc27c7efc2beecebf66ce9838a","download_count":3976,"created_at":"2026-10-02T17:11:12Z","updated_at":"2026-10-02T17:11:13Z"}],"body":"## Clef decision models\r\n\r\nOllama now supports [Clef](https://ollama.com/library/clef) and [Clef Flash](https://ollama.com/library/clef), Cloudflare's new open-source decision models, through `/v1/systemone`.\r\n\r\nClef (27B) and Clef Flash (9B) are multimodal: requests can now include images alongside the text state, shared by all questions and scored jointly with it.\r\n\r\n```sh\r\ncurl http://localhost:11434/v1/systemone -d '{\r\n  \"model\": \"clef-flash\",\r\n  \"state\": \"The user took this screenshot.\",\r\n  \"images\": [\"<base64-encoded image>\"],\r\n  \"questions\": {\r\n    \"has_ollama\": {\"type\": \"noul\", \"instructions\": \"Does this image contain Ollama?\"}\r\n  }\r\n}'\r\n```\r\n\r\n```\r\n{\r\n  \"model\": \"clef-flash\",\r\n  \"answers\": {\r\n    \"has_ollama\": {\r\n      \"type\": \"noul\",\r\n      \"noul\": 0.958\r\n    }\r\n  },\r\n  \"usage\": {\r\n    \"input_tokens\": 548,\r\n    \"output_tokens\": 0\r\n  }\r\n}\r\n```\r\n## What's Changed\r\n* Models using web search can now perform up to ten searches per response, up from three\r\n* Modelfiles now support `CAPABILITY` declarations, so model creators can explicitly declare what a model can do. Declarations are preserved when creating from GGUF or safetensors, through model inheritance, and on Modelfile export\r\n* `ollama show` and the model list now report only `decision` as the capability for decision models, so clients no longer offer them for general chat, tools, or thinking\r\n* Updated llama.cpp and the MLX engine\r\n\r\n**Full Changelog**: https://github.com/ollama/ollama/compare/v0.35.0...v0.35.1\r\n","reactions":{"total_count":21,"+1":17,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":4,"eyes":0}}
