n/octet-stream","state":"uploaded","size":108,"digest":"sha256:db2172df06951dcd210968f1f0ed985e68ee4ceb625ea62bfd2dea897bcf070e","download_count":2,"created_at":"2026-09-16T02:46:37Z","updated_at":"2026-09-16T02:46:37Z"},{"id":567015691,"node_id":"RA_kwDOPF0svM4hy_kL","name":"parqeye.rb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-ruby","state":"uploaded","size":2482,"digest":"sha256:95b5b61a7cbaf2338ce1d5c316c89eca238330d1b8ab9e2d22ad812a829f026f","download_count":2,"created_at":"2026-09-16T02:46:37Z","updated_at":"2026-09-16T02:46:38Z"},{"id":567015699,"node_id":"RA_kwDOPF0svM4hy_kT","name":"sha256.sum","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":798,"digest":"sha256:5766c7583c0c1be569158fad980fe1216c4f7e6ad5f01abc97d00d4a13930b59","download_count":2,"created_at":"2026-09-16T02:46:38Z","updated_at":"2026-09-16T02:46:38Z"},{"id":567015695,"node_id":"RA_kwDOPF0svM4hy_kP","name":"source.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":1395525,"digest":"sha256:ba1b686bf5aa12a4233c8ebc4821f3a1360782bfd8e3dcca1e3536f104f45017","download_count":2,"created_at":"2026-09-16T02:46:38Z","updated_at":"2026-09-16T02:46:38Z"},{"id":567015698,"node_id":"RA_kwDOPF0svM4hy_kS","name":"source.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":81,"digest":"sha256:7e6d3ed78e5ad003e02724206e6f77ada656fc8de174a22092fba3100538ac5d","download_count":2,"created_at":"2026-09-16T02:46:38Z","updated_at":"2026-09-16T02:46:38Z"}],"body":"## Release Notes\n\n### Added\n\n- Support for large Parquet files with large row counts in the data preview ([#43](https://github.com/kaushiksrini/parqeye/pull/43))\n- `g`/`G` shortcuts to jump to the top/bottom of the data preview ([#43](https://github.com/kaushiksrini/parqeye/pull/43))\n- PyPI package and build workflow, so you can invoke `uvx parqeye` ([#40](https://github.com/kaushiksrini/parqeye/pull/40))\n\n### Fixed\n\n- Incorrect Min/Max aggregation in the Schema tab ([#44](https://github.com/kaushiksrini/parqeye/pull/44))\n- Column file offset and distinct count now show `N/A` when not set in the file metadata ([#46](https://github.com/kaushiksrini/parqeye/pull/46))\n- PyPI workflow builds for Linux `manylinux_2_28` ([#41](https://github.com/kaushiksrini/parqeye/pull/41))\n- add `dtype-extension` to support extension types and handle panics with the polars crate ([#45](https://github.com/kaushiksrini/parqeye/pull/45))\n\n### Changed\n\n- Lazily load page info to speed up startup ([#32](https://github.com/kaushiksrini/parqeye/pull/32))\n\n## Install parqeye 0.2.0\n\n### Install prebuilt binaries via shell script\n\n```sh\ncurl --proto '=https' --tlsv1.2 -LsSf https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-installer.sh | sh\n```\n\n### Install prebuilt binaries via Homebrew\n\n```sh\nbrew install kaushiksrini/parqeye/parqeye\n```\n\n### Install prebuilt binaries into your npm project\n\n```sh\nnpm install parqeye@0.2.0\n```\n\n## Download parqeye 0.2.0\n\n|  File  | Platform | Checksum |\n|--------|----------|----------|\n| [parqeye-aarch64-apple-darwin.tar.xz](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-aarch64-apple-darwin.tar.xz) | Apple Silicon macOS | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-aarch64-apple-darwin.tar.xz.sha256) |\n| [parqeye-x86_64-apple-darwin.tar.xz](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-apple-darwin.tar.xz) | Intel macOS | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-apple-darwin.tar.xz.sha256) |\n| [parqeye-x86_64-pc-windows-msvc.zip](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-pc-windows-msvc.zip) | x64 Windows | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-pc-windows-msvc.zip.sha256) |\n| [parqeye-aarch64-unknown-linux-gnu.tar.xz](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-aarch64-unknown-linux-gnu.tar.xz) | ARM64 Linux | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-aarch64-unknown-linux-gnu.tar.xz.sha256) |\n| [parqeye-x86_64-unknown-linux-gnu.tar.xz](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-unknown-linux-gnu.tar.xz) | x64 Linux | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-unknown-linux-gnu.tar.xz.sha256) |\n| [parqeye-x86_64-unknown-linux-musl.tar.xz](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-unknown-linux-musl.tar.xz) | x64 MUSL Linux | [checksum](https://github.com/kaushiksrini/parqeye/releases/download/v0.2.0/parqeye-x86_64-unknown-linux-musl.tar.xz.sha256) |\n\n\n"}
