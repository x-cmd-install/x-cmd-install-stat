5299,"node_id":"RA_kwDON-sE7c4q9_1D","name":"mq-x86_64-unknown-linux-gnu.rpm","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-rpm","state":"uploaded","size":4386638,"digest":"sha256:e5bbcdae7e12b013d2edb11a7fe1abe3a61de8d66d31c370a19d7d0334c017af","download_count":1,"created_at":"2026-11-07T14:13:52Z","updated_at":"2026-11-07T14:13:53Z"},{"id":720895439,"node_id":"RA_kwDON-sE7c4q9_3P","name":"mq-x86_64-unknown-linux-musl","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":13012144,"digest":"sha256:63bdd31592f9f8eed10ee53755d80253f17c72a536a9f3b020841e9584b8c3f2","download_count":1,"created_at":"2026-11-07T14:13:57Z","updated_at":"2026-11-07T14:13:57Z"},{"id":720895367,"node_id":"RA_kwDON-sE7c4q9_2H","name":"mq-x86_64-unknown-linux-musl.deb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-debian-package","state":"uploaded","size":4167052,"digest":"sha256:b1a3d33154b7e7050f2678b536c96423f8d4301cc72ce8802e4488e9610f3f1a","download_count":1,"created_at":"2026-11-07T14:13:54Z","updated_at":"2026-11-07T14:13:55Z"},{"id":720895374,"node_id":"RA_kwDON-sE7c4q9_2O","name":"mq-x86_64-unknown-linux-musl.rpm","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-rpm","state":"uploaded","size":4500016,"digest":"sha256:417e75afe273739d56f6df8b344d7582ab0341b06bb784bbfd3879bf6e267cdc","download_count":1,"created_at":"2026-11-07T14:13:54Z","updated_at":"2026-11-07T14:13:55Z"}],"body":"## What's Changed\r\n\r\n### Features\r\n\r\n- ✨ feat(bench): add statistics, batching, cold runs and heap counts by @harehare in https://github.com/harehare/mq/pull/2804\r\n- ✨ feat(check): reject a record argument missing a required field by @harehare in https://github.com/harehare/mq/pull/2778\r\n- ✨ feat(check): type dict-returning builtins as records by @harehare in https://github.com/harehare/mq/pull/2777\r\n- ✨ feat(check): type-check user-defined tagged results ({ok: true, ...} | {ok: false, ...}) by @harehare in https://github.com/harehare/mq/pull/2802\r\n- ✨ feat(lang): support unicode general categories and scripts in regex by @harehare in https://github.com/harehare/mq/pull/2747\r\n- ✨ feat(lang): add the hash and bit_length builtins  by @harehare in https://github.com/harehare/mq/pull/2755\r\n- ✨ feat(lang): let band, bor and xor combine integers by @harehare in https://github.com/harehare/mq/pull/2756\r\n- ✨ feat(lang): allow error() to raise any value by @harehare in https://github.com/harehare/mq/pull/2769\r\n- ✨ feat(lang): print very large and very small numbers in exponent notation by @harehare in https://github.com/harehare/mq/pull/2773\r\n- ✨ feat(lang): add regex_match_info for match positions and capture groups by @harehare in https://github.com/harehare/mq/pull/2775\r\n- ✨ feat(lang): add hmac_sha256 and hmac_sha512 builtins by @harehare in https://github.com/harehare/mq/pull/2803\r\n- ✨ feat(lsp): context-aware completion, module navigation and new requests by @harehare in https://github.com/harehare/mq/pull/2759\r\n- ✨ feat(markdown): add option to disable table cell padding by @harehare in https://github.com/harehare/mq/pull/2795\r\n- ✨ feat(run): decode UTF-16 input with a BOM and hint on other encodings by @harehare in https://github.com/harehare/mq/pull/2764\r\n- ✨ feat(test): add @small_scope and fix the bugs it found in lang modules by @harehare in https://github.com/harehare/mq/pull/2822\r\n\r\n### Fixes\r\n\r\n- 🐛 fix(check): reject calls of non-function values and wrong keys/range arguments by @harehare in https://github.com/harehare/mq/pull/2744\r\n- 🐛 fix(check): avoid race when writing shared module file in tests by @harehare in https://github.com/harehare/mq/pull/2780\r\n- 🐛 fix(ci): build fuzz targets for the gnu triple by @harehare in https://github.com/harehare/mq/pull/2805\r\n- 🐛 fix(formatter): sort only consecutive statements of the same kind by @harehare in https://github.com/harehare/mq/pull/2743\r\n- 🐛 fix(hir): return syntax errors from Hir::add_code by @harehare in https://github.com/harehare/mq/pull/2739\r\n- 🐛 fix(hir): parse expressions inside string interpolation by @harehare in https://github.com/harehare/mq/pull/2741\r\n- 🐛 fix(lang): release pooled frame locals so passed values are not kept alive by @harehare in https://github.com/harehare/mq/pull/2748\r\n- 🐛 fix(lang): keep x[i] and x[a:b] from calling a user-defined get or slice by @harehare in https://github.com/harehare/mq/pull/2752\r\n- 🐛 fix(lang): make modulo by zero an error like division by @harehare in https://github.com/harehare/mq/pull/2765\r\n- 🐛 fix(lang): validate code points in implode by @harehare in https://github.com/harehare/mq/pull/2766\r\n- 🐛 fix(lang): reject negative shift amounts in shift_left/shift_right by @harehare in https://github.com/harehare/mq/pull/2767\r\n- 🐛 fix(lang): reject non-finite values in to_number by @harehare in https://github.com/harehare/mq/pull/2768\r\n- 🐛 fix(lang): only divide by exactly zero raises a zero division error by @harehare in https://github.com/harehare/mq/pull/2772\r\n- 🐛 fix(lang): make indices return overlapping matches like jq by @harehare in https://github.com/harehare/mq/pull/2785\r\n- 🐛 fix(lang): fix lpad/rpad with long pads and split with empty separator by @harehare in https://github.com/harehare/mq/pull/2786\r\n- 🐛 fix(lang): point bnot on numbers to xor with an explicit mask by @harehare in https://github.com/harehare/mq/pull/2794\r\n- 🐛 fix(lang): stop recursive defs from leaking through a self-referencing cell by @harehare in https://github.com/harehare/mq/pull/2824\r\n- 🐛 fix(lang): stop recursive defs with defaults from leaking through a self cell by @harehare in https://github.com/harehare/mq/pull/2825\r\n- 🐛 fix(lang): free a closure stored in a variable it captures by @harehare in https://github.com/harehare/mq/pull/2829\r\n- 🐛 fix(lang): collect closure reference cycles through captured variables by @harehare in https://github.com/harehare/mq/pull/2830\r\n- 🐛 fix(lang): return early when repeating an empty array by @harehare in https://github.com/harehare/mq/pull/2831\r\n- 🐛 fix(lang): collect cycles held only by returned values when the engine drops by @harehare in https://github.com/harehare/mq/pull/2832\r\n- 🐛 fix(lsp): convert new navigation ranges to UTF-16 columns by @harehare in https://github.com/harehare/mq/pull/2762\r\n- 🐛 fix(markdown): improve html to markdown code blocks and link text by @harehare in https://github.com/harehare/mq/pull/2813\r\n- 🔒 fix(run): honor --allow-write for --in-place by @harehare in https://github.com/harehare/mq/pull/2719\r\n- 🐛 fix(run): write non-finite numbers the way jq does by @harehare in https://github.com/harehare/mq/pull/2784\r\n- 🐛 fix(run): reject UTF-16 input without a BOM by @harehare in https://github.com/harehare/mq/pull/2787\r\n- 🐛 fix(test): detect failed assertions inside loops by @harehare in https://github.com/harehare/mq/pull/2749\r\n\r\n### Refactoring\r\n\r\n- ♻  refactor(lang): read $NAME when the program runs instead of while parsing by @harehare in https://github.com/harehare/mq/pull/2742\r\n- ♻  refactor(lang): expose the keyword list from one table shared with the lexer by @harehare in https://github.com/harehare/mq/pull/2753\r\n\r\n### Performance\r\n\r\n- ⚡ perf(bench): use mimalloc in mq-bench like the mq binary by @harehare in https://github.com/harehare/mq/pull/2789\r\n- ⚡ perf(lang): make string indexing and slicing linear over a scan by @harehare in https://github.com/harehare/mq/pull/2746\r\n- ⚡ perf(lang): move a local out on its last use instead of cloning it by @harehare in https://github.com/harehare/mq/pull/2745\r\n- ⚡ perf(lang): count the chars of an ASCII string by its byte length by @harehare in https://github.com/harehare/mq/pull/2750\r\n- ⚡ perf(lang): make dict removal amortized O(1) by @harehare in https://github.com/harehare/mq/pull/2751\r\n- ⚡ perf(lang): update nested index assignments in place by @harehare in https://github.com/harehare/mq/pull/2754\r\n- ⚡ perf(lang): cut an unshared array in place in slice by @harehare in https://github.com/harehare/mq/pull/2758\r\n- ⚡ perf(lang): append to captured variables in place by @harehare in https://github.com/harehare/mq/pull/2770\r\n- ⚡ perf(lang): raise the call depth limit to 100,000 and guard nested coroutine resumes by @harehare in https://github.com/harehare/mq/pull/2776\r\n- ⚡ perf(lang): speed up fold, sum and zip in builtin.mq by @harehare in https://github.com/harehare/mq/pull/2788\r\n- ⚡ perf(lang): add numbers in place for a[i] += x and accept computed keys by @harehare in https://github.com/harehare/mq/pull/2791\r\n- ⚡ perf(lang): compute number operands on the stack without moving them out by @harehare in https://github.com/harehare/mq/pull/2792\r\n- ⚡ perf(lang): fold constant expressions and drop dead branches by @harehare in https://github.com/harehare/mq/pull/2800\r\n- ⚡ perf(lang): shrink VmError from 56 to 24 bytes by @harehare in https://github.com/harehare/mq/pull/2816\r\n- ⚡ perf(lint): index symbols by parent instead of rescanning the HIR by @harehare in https://github.com/harehare/mq/pull/2760\r\n- ⚡ perf(markdown): build flattened nodes in place and presize the root list by @harehare in https://github.com/harehare/mq/pull/2812\r\n\r\n### Test\r\n\r\n- ✅ test(lang): add Kani proofs for peephole, wire, slice bounds and mq-markdown positions by @harehare in https://github.com/harehare/mq/pull/2738\r\n- ✅ test(lang): prove peephole jump rewriting and arena id packing with Kani by @harehare in https://github.com/harehare/mq/pull/2740\r\n- ✅ test(lang): assert RuntimeValue stays at most 16 bytes by @harehare in https://github.com/harehare/mq/pull/2801\r\n- ✅ test(lang,markdown): prove scan helpers and slot bounds with Kani by @harehare in https://github.com/harehare/mq/pull/2811\r\n\r\n### CI\r\n\r\n- 👷 ci(bench): use OIDC auth for CodSpeed instead of token by @harehare in https://github.com/harehare/mq/pull/2761\r\n\r\n### Dependency Updates\r\n\r\n<details>\r\n<summary>20 dependency updates</summary>\r\n\r\nCargo / GitHub Actions (root)\r\n- chore(deps): bump the dependencies group with 4 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2736\r\n- chore(deps): bump the dependencies group with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2735\r\n- build(deps): bump taiki-e/install-action from 2.87.31 to 2.87.32 in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2783\r\n- build(deps): bump the dependencies group with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2782\r\n- build(deps): bump ignore from 0.4.33 to 0.4.34 in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2799\r\n- build(deps): bump the dependencies group with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2810\r\n- build(deps): bump unicode-width from 0.2.2 to 0.2.3 in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2809\r\n- build(deps): bump the dependencies group with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2828\r\n- build(deps): bump encoding_rs from 0.8.42 to 0.8.44 in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2827\r\n\r\neditors/vscode\r\n- build(deps-dev): bump oxlint from 1.89.0 to 1.90.0 in /editors/vscode in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2796\r\n- build(deps-dev): bump @types/node from 26.6.5 to 26.6.6 in /editors/vscode in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2806\r\n- build(deps-dev): bump @types/vscode from 1.140.0 to 1.144.0 in /editors/vscode in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2820\r\n\r\npackages/mq-playground\r\n- chore(deps-dev): bump @babel/core from 7.29.7 to 8.0.9 in /packages/mq-playground in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2734\r\n- build(deps-dev): bump @babel/core from 7.29.7 to 8.0.9 in /packages/mq-playground in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2781\r\n- build(deps-dev): bump the dependencies group in /packages/mq-playground with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2798\r\n- build(deps-dev): bump @babel/core from 7.29.7 to 8.0.9 in /packages/mq-playground in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2808\r\n- build(deps-dev): bump the dependencies group in /packages/mq-playground with 2 updates by @dependabot[bot] in https://github.com/harehare/mq/pull/2821\r\n- build(deps-dev): bump @babel/core from 7.29.7 to 8.0.10 in /packages/mq-playground in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2826\r\n\r\npackages/mq-web\r\n- build(deps-dev): bump oxlint from 1.89.0 to 1.90.0 in /packages/mq-web in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2797\r\n- build(deps-dev): bump @types/node from 26.6.5 to 26.6.6 in /packages/mq-web in the dependencies group by @dependabot[bot] in https://github.com/harehare/mq/pull/2807\r\n\r\n</details>\r\n\r\nFull Changelog: https://github.com/harehare/mq/compare/v0.10.0...v0.10.1\r\n","mentions_count":2}
