zip","state":"uploaded","size":8505806,"digest":"sha256:36f1524f0cfaf33f5dfe68ac19220e1bd57ded1f0f9205931f6ee1de32f4a040","download_count":196,"created_at":"2026-11-12T21:53:03Z","updated_at":"2026-11-12T21:53:05Z"},{"id":741227514,"node_id":"RA_kwDOOBOm5M4sLjv6","name":"rumdl-v0.3.4-x86_64-unknown-linux-gnu.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":111,"digest":"sha256:5c1630fca76396001a8e630576b32d9cddb5dc9da7e1fcbaec51752ab17fddb5","download_count":39,"created_at":"2026-11-12T21:53:03Z","updated_at":"2026-11-12T21:53:04Z"},{"id":741227509,"node_id":"RA_kwDOOBOm5M4sLjv1","name":"rumdl-v0.3.4-x86_64-unknown-linux-musl.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/gzip","state":"uploaded","size":8474970,"digest":"sha256:2e64c7654906f0df82218fcc73cbdded2e41f37961f5be3e876e708bdf42e367","download_count":142,"created_at":"2026-11-12T21:53:03Z","updated_at":"2026-11-12T21:53:05Z"},{"id":741227516,"node_id":"RA_kwDOOBOm5M4sLjv8","name":"rumdl-v0.3.4-x86_64-unknown-linux-musl.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":112,"digest":"sha256:75300d36c2b8986b36cdebb96670abe281502251d12adcc6e4fbcf039f58124a","download_count":112,"created_at":"2026-11-12T21:53:03Z","updated_at":"2026-11-12T21:53:04Z"}],"body":"\n### Breaking Changes\n\n- **Rust library API:** Removed unused helpers and deprecated compatibility wrappers.\n  Use `warning_to_code_actions` instead of `warning_to_code_action`. See the\n  [cleanup commit](https://github.com/rvben/rumdl/commit/a58150c893dbf93f368abfd4a690433fdaf2f4f9)\n  for the complete list of removals.\n\n### Added\n\n- **MD013**: check and reflow frontmatter values (#998) ([c40744c](https://github.com/rvben/rumdl/commit/c40744c0d1ff37d3322a327ec50685a4c4eff7ae))\n- **schema**: describe rule sections and option types (#997) ([da0faf7](https://github.com/rvben/rumdl/commit/da0faf791b163ee97d302a9534fb113fa8f8bb83))\n\n### Fixed\n\n- **MD013**: measure frontmatter before Markdown exemptions ([45841ff](https://github.com/rvben/rumdl/commit/45841ff77f709f7f23c4b444e0b67c5b6f919314))\n- **schema**: preserve rule aliases and refresh generated options ([4a8e9ef](https://github.com/rvben/rumdl/commit/4a8e9ef4af9e2f0a4d311d78b6807af58389ea30))\n- **links**: preserve wrapped reference definition metadata ([45d2fd9](https://github.com/rvben/rumdl/commit/45d2fd962f9f468868e163539e70fc2e16a928b9))\n- **MD034**: recognize link definitions whose URL is on the next line (#995) ([2db197f](https://github.com/rvben/rumdl/commit/2db197f9641e9c2ed1ab8a018a7796b87e28695b))\n\n\n## Downloads\n\n| File | Platform | Checksum |\n|------|----------|----------|\n| [rumdl-v0.3.4-x86_64-unknown-linux-gnu.tar.gz](https://github.com/rvben/rumdl/releases/download/v0.3.4/rumdl-v0.3.4-x86_64-unknown-linux-gnu.tar.gz) | Linux x86_64 | [checksum](https://github.com/rvben/rumdl/releases/download/v0.3.4/rumdl-v0.3.4-x86_64-unknown-linux-gnu.tar.gz.sha256) |\n| [rumdl-v0.3.4-x86_64-unknown-linux-musl.tar.gz](https://github.com/rvben/rumdl/releases/download/v0.3.4/rumdl-v0.3.4-x86_64-unknown-linux-musl.tar.gz) | Linux x86_64 (musl) | [checksum](https://github.com/rvben/rumdl/releases/download/v0.3.4/rumdl-v0.3.4-x86_64-unknown-linux-musl.tar.gz.sha256) |\n| [rumdl-v0.3.4-aarch64-unknown-linux-gnu.tar.gz](https://github.com/rvben/rumdl/releases/download/v0.3.4/rumdl-v0.3.4-aarch64-unknown-linux-gnu.tar.gz) | Linux ARM64 | [checksum](https://github.com/rvben/rumdl