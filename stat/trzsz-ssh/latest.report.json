er_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":7530205,"digest":"sha256:826281f6a111ce290062bc3125c3d5c075916763536a30b6100460f372b6c8e3","download_count":19,"created_at":"2026-10-25T00:46:59Z","updated_at":"2026-10-25T00:47:00Z"},{"id":673717051,"node_id":"RA_kwDOJlk_CM4oKBs7","name":"tssh_0.1.27_windows_i386.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":8189827,"digest":"sha256:1dd70e2e32cf76fe391d9bd1931e178d1c4663fa4f02386765be113906c8fb2c","download_count":25,"created_at":"2026-10-25T00:46:59Z","updated_at":"2026-10-25T00:47:00Z"},{"id":673717043,"node_id":"RA_kwDOJlk_CM4oKBsz","name":"tssh_0.1.27_windows_x86_64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":8555823,"digest":"sha256:7d71f7103f0c9575ed4be259f6c22528dd0eaed20a72560173ccc4f4b8ba8a52","download_count":196,"created_at":"2026-10-25T00:46:59Z","updated_at":"2026-10-25T00:47:01Z"}],"body":"## What's Changed\r\n\r\n### ✨ Features\r\n- **UDP Mode:** Add native `ControlMaster` multiplexing support in UDP mode by @soupdiver in https://github.com/trzsz/trzsz-ssh/pull/284\r\n- **Zmodem:** Support Zmodem auto-rename and transfer summaries.\r\n- **Auto-Upload:** Support allowed auto-upload directories for `trzsz`.\r\n- **UI:** Add `PromptSearchPointer` configuration option to customize the search cursor style (#272).\r\n\r\n### 🐛 Bug Fixes\r\n- **Configuration:**\r\n  - Fix `ssh -G` effective config loading and caching bugs (#285).\r\n  - Fix Windows path parsing for file configuration options (#285).\r\n  - Fallback to canonical destination when `HostName` is empty (#273).\r\n- **Known Hosts:**\r\n  - Automatically create missing user `known_hosts` file and directory (#285, #286).\r\n  - Ignore malformed `known_hosts` entries by @eejd in https://github.com/trzsz/trzsz-ssh/pull/274\r\n- **Session & Execution:**\r\n  - Fix command pipe handling.\r\n  - Fix session exit status and suppress normal exit warnings.\r\n  - Handle shell EOF gracefully to align with OpenSSH behavior (#275).\r\n  - Fix control master option passed to `ssh` (#279).\r\n- **SSH & Networking:**\r\n  - Fix: support `@` in SSH usernames by @SomSamantray in https://github.com/trzsz/trzsz-ssh/pull/288\r\n  - Keep `%C` hash consistent with OpenSSH when a proxy jump is used by @Mrkinggggg in https://github.com/trzsz/trzsz-ssh/pull/291\r\n  - Add the root KSK-2024 trust anchor (key tag 38696) for DNSSEC validation by @CyberNativeAI in https://github.com/trzsz/trzsz-ssh/pull/290\r\n- **UDP Preview:**\r\n  - Correctly calculate display width and clip text containing ANSI styles in attach previews.\r\n\r\n### 🚀 Maintenance & Improvements\r\n- **Go Upgrade:** Upgrade CI, release builds, and dependencies to **Go 1.26**.\r\n- **Token Alignment:** Align `%j` and `%C` token expansion with modern OpenSSH versions.\r\n- **Power Management:** Pause UDP reconnects when macOS graphics are inactive (Dark Wake support).\r\n\r\n## New Contributors\r\n* @eejd made their first contribution in https://github.com/trzsz/trzsz-ssh/pull/274\r\n* @SomSamantray made their first contribution in https://github.com/trzsz/trzsz-ssh/pull/288\r\n* @CyberNativeAI made their first contribution in https://github.com/trzsz/trzsz-ssh/pull/290\r\n* @Mrkinggggg made their first contribution in https://github.com/trzsz/trzsz-ssh/pull/291\r\n* @soupdiver made their first contribution in https://github.com/trzsz/trzsz-ssh/pull/284\r\n\r\n**Full Changelog**: https://github.com/trzsz/trzsz-ssh/compare/v0.1.26...v0.1.27","mentions_count":5}
