:1063,"created_at":"2026-11-24T21:15:40Z","updated_at":"2026-11-24T21:15:41Z"},{"id":788885027,"node_id":"RA_kwDOKbIFZc4vBW4j","name":"uv-x86_64-unknown-linux-gnu.tar.gz","label":"","uploader":{"login":"astral-releases-bot[bot]","id":328004183,"node_id":"BOT_kgDOE4zyVw","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":17113138,"digest":"sha256:bf65ac1a0af10f92c522d91ac096c7c0a39657647b155577e7836c2cbbb4526c","download_count":1727983,"created_at":"2026-11-24T21:15:40Z","updated_at":"2026-11-24T21:15:41Z"},{"id":788885039,"node_id":"RA_kwDOKbIFZc4vBW4v","name":"uv-x86_64-unknown-linux-gnu.tar.gz.sha256","label":"","uploader":{"login":"astral-releases-bot[bot]","id":328004183,"node_id":"BOT_kgDOE4zyVw","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":101,"digest":"sha256:00e644a6812c0c7f5156403e84266178fa14473eee841daeb773ce40a8322eb0","download_count":1981,"created_at":"2026-11-24T21:15:41Z","updated_at":"2026-11-24T21:15:41Z"},{"id":788885050,"node_id":"RA_kwDOKbIFZc4vBW46","name":"uv-x86_64-unknown-linux-musl.tar.gz","label":"","uploader":{"login":"astral-releases-bot[bot]","id":328004183,"node_id":"BOT_kgDOE4zyVw","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":18964884,"digest":"sha256:5597970380083a340b7983af05a84824b4db1c62b7059c796935b7fd6dc95fd2","download_count":2190,"created_at":"2026-11-24T21:15:41Z","updated_at":"2026-11-24T21:15:42Z"},{"id":788885057,"node_id":"RA_kwDOKbIFZc4vBW5B","name":"uv-x86_64-unknown-linux-musl.tar.gz.sha256","label":"","uploader":{"login":"astral-releases-bot[bot]","id":328004183,"node_id":"BOT_kgDOE4zyVw","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":102,"digest":"sha256:004b1cf19dd5f99e677ebaf2446a855775688b378c45c96ebde014b1ba9fd384","download_count":352,"created_at":"2026-11-24T21:15:41Z","updated_at":"2026-11-24T21:15:42Z"}],"body":"## Release Notes\r\n\r\nReleased on 2026-11-24.\r\n\r\nThis release addresses GHSA-vjvj-3m3f-fgmm.\r\n\r\n### Enhancements\r\n\r\n- Validate that dependency requirements in `uv.lock` match the locked package versions ([astral-sh/uv#23238](https://github.com/astral-sh/uv/pull/23238))\r\n- Explain why `uv.lock` needs to be updated when `--locked` rejects it ([astral-sh/uv#23251](https://github.com/astral-sh/uv/pull/23251))\r\n- Report dependencies whose package entries are missing from `uv.lock` ([astral-sh/uv#23304](https://github.com/astral-sh/uv/pull/23304))\r\n\r\n### Python\r\n\r\n- Update managed CPython 3.11.18, 3.12.16, 3.13.18, 3.14.10, 3.15.2, and 3.16.0a2 builds ([astral-sh/uv#23240](https://github.com/astral-sh/uv/pull/23240), [astral-sh/uv#23397](https://github.com/astral-sh/uv/pull/23397))\r\n- Update GraalPy 3.13.0 to build 25.6.5 ([astral-sh/uv#23397](https://github.com/astral-sh/uv/pull/23397))\r\n\r\n### Preview features\r\n\r\n- Use proxy indexes while keeping lockfiles portable to their upstream indexes through reversible artifact URLs ([astral-sh/uv#20790](https://github.com/astral-sh/uv/pull/20790), [astral-sh/uv#23276](https://github.com/astral-sh/uv/pull/23276))\r\n\r\n### Bug fixes\r\n\r\n- Reject wheels whose ZIP data descriptor and central directory disagree on the compressed size ([astral-sh/uv#23332](https://github.com/astral-sh/uv/pull/23332))\r\n- Refresh cached interpreter information when libc, the macOS version, or `pyvenv.cfg` changes ([astral-sh/uv#23214](https://github.com/astral-sh/uv/pull/23214), [astral-sh/uv#23215](https://github.com/astral-sh/uv/pull/23215), [astral-sh/uv#23216](https://github.com/astral-sh/uv/pull/23216))\r\n- Allow `uv sync --no-install-package` to skip packages without a compatible distribution ([astral-sh/uv#23338](https://github.com/astral-sh/uv/pull/23338))\r\n- Ignore unreachable wheels before requiring hashes for `uv.lock` ([astral-sh/uv#23312](https://github.com/astral-sh/uv/pull/23312))\r\n- Avoid reusing yanked pins with unsatisfiable markers in `uv pip compile --universal` ([astral-sh/uv#23394](https://github.com/astral-sh/uv/pull/23394))\r\n\r\n### Documentation\r\n\r\n- Cite Minato's original description of the ISOP algorithm ([astral-sh/uv#23303](https://github.com/astral-sh/uv/pull/23303))\r\n\r\n### Other changes\r\n\r\n- Update the bundled Mozilla root certificates via `webpki-root-certs` 1.0.12 ([astral-sh/uv#23302](https://github.com/astral-sh/uv/pull/23302))\r\n\r\n## Install uv 0.13.10\r\n\r\n### Install prebuilt binaries via shell script\r\n\r\n```sh\r\ncurl --proto '=https' --tlsv1.2 -LsSf https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-installer.sh | sh\r\n```\r\n\r\n### Install prebuilt binaries via powershell script\r\n\r\n```sh\r\npowershell -ExecutionPolicy Bypass -c \"irm https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-installer.ps1 | iex\"\r\n```\r\n\r\n## Download uv 0.13.10\r\n\r\n|  File  | Platform | Checksum |\r\n|--------|----------|----------|\r\n| [uv-aarch64-apple-darwin.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-apple-darwin.tar.gz) | Apple Silicon macOS | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-apple-darwin.tar.gz.sha256) |\r\n| [uv-x86_64-apple-darwin.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-x86_64-apple-darwin.tar.gz) | Intel macOS | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-x86_64-apple-darwin.tar.gz.sha256) |\r\n| [uv-aarch64-pc-windows-msvc.zip](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-pc-windows-msvc.zip) | ARM64 Windows | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-pc-windows-msvc.zip.sha256) |\r\n| [uv-i686-pc-windows-msvc.zip](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-i686-pc-windows-msvc.zip) | x86 Windows | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-i686-pc-windows-msvc.zip.sha256) |\r\n| [uv-x86_64-pc-windows-msvc.zip](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-x86_64-pc-windows-msvc.zip) | x64 Windows | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-x86_64-pc-windows-msvc.zip.sha256) |\r\n| [uv-aarch64-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-unknown-linux-gnu.tar.gz) | ARM64 Linux | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-aarch64-unknown-linux-gnu.tar.gz.sha256) |\r\n| [uv-i686-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-i686-unknown-linux-gnu.tar.gz) | x86 Linux | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-i686-unknown-linux-gnu.tar.gz.sha256) |\r\n| [uv-powerpc64le-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-powerpc64le-unknown-linux-gnu.tar.gz) | PPC64LE Linux | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-powerpc64le-unknown-linux-gnu.tar.gz.sha256) |\r\n| [uv-riscv64gc-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-riscv64gc-unknown-linux-gnu.tar.gz) | RISCV Linux | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-riscv64gc-unknown-linux-gnu.tar.gz.sha256) |\r\n| [uv-s390x-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-s390x-unknown-linux-gnu.tar.gz) | S390x Linux | [checksum](https://releases.astral.sh/github/uv/releases/download/0.13.10/uv-s390x-unknown-linux-gnu.tar.gz.sha256) |\r\n| [uv-x86_64-unknown-linux-gnu.tar.gz](https://releases.astral.sh/github/uv/relea