c51e","download_count":1346,"created_at":"2026-11-17T14:08:36Z","updated_at":"2026-11-17T14:08:38Z"},{"id":759307957,"node_id":"RA_kwDOGxaghM4tQh61","name":"mirrord_mac_universal","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":410724832,"digest":"sha256:f45d5ebda0349f8cdae430c347cc4772e4856c1a608a7c96e1c3c01a1f632b01","download_count":7042,"created_at":"2026-11-17T14:08:36Z","updated_at":"2026-11-17T14:08:50Z"},{"id":759307952,"node_id":"RA_kwDOGxaghM4tQh6w","name":"mirrord_mac_universal.shasum256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":92,"digest":"sha256:ea1ed1fc295d9939fe99620e10f5da89b37939e2f04616fe045e978024dbe041","download_count":52,"created_at":"2026-11-17T14:08:36Z","updated_at":"2026-11-17T14:08:36Z"},{"id":759307954,"node_id":"RA_kwDOGxaghM4tQh6y","name":"mirrord_mac_universal.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":162979262,"digest":"sha256:8f49c8345acc5002282e3126d30e408698a8359a95079b9210091179680448c7","download_count":1803,"created_at":"2026-11-17T14:08:36Z","updated_at":"2026-11-17T14:08:43Z"}],"body":"\n\n### Added\n\n- `mirrord preview start` and `mirrord preview up` can now run without a target\n  to provision branch databases alone: with `feature.db_branches` and no\n  `target`, the operator creates the branches and keeps them for the preview's\n  TTL. A targetless `mirrord exec` with branches the operator provisions\n  creates them the same way and gets their connection values in its\n  environment. Branch connection values must then come from a literal, a\n  Kubernetes Secret, or a ConfigMap named directly, since there is no target\n  pod to read them from. Secret manager sources and `iam_auth` work without a\n  target only for S3 and turbopuffer branches, and Spanner branches still need\n  a target.\n\n\n### Fixed\n\n- The serverless workload companion and the CLI's sessions-manager connection\n  trust the CA certificates bundled into mirrord, alongside the system's when\n  it has any, so application images no longer need `ca-certificates` installed\n  to connect to MetalBear Cloud. The data-plane connection trusts the system's\n  CA certificates too, so a sessions-manager behind a private CA or a\n  transparently intercepting proxy no longer passes registration only to fail\n  every data-plane connection.\n\n"}
