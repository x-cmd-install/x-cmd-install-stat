gDOBWzV5g","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-xz","state":"uploaded","size":103302240,"digest":"sha256:ac0fc39fd2342066027e56a42bdebfea910e9fdc539d02dd7d658e39c38e42dc","download_count":508,"created_at":"2026-11-06T19:03:32Z","updated_at":"2026-11-06T19:03:38Z"},{"id":718224561,"node_id":"RA_kwDOLmfWBM4qzzyx","name":"zen.linux-x86_64.tar.xz","label":"","uploader":{"login":"mr-cheffy","id":91018726,"node_id":"U_kgDOBWzV5g","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-xz","state":"uploaded","size":113754680,"digest":"sha256:c592a31fe8faa5ddfe91d6243b50c3107e1831c1247539fe03cc04f0fd5cb9cd","download_count":18232,"created_at":"2026-11-06T19:03:32Z","updated_at":"2026-11-06T19:03:37Z"},{"id":718224548,"node_id":"RA_kwDOLmfWBM4qzzyk","name":"zen.macos-universal.dmg","label":"","uploader":{"login":"mr-cheffy","id":91018726,"node_id":"U_kgDOBWzV5g","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":239350232,"digest":"sha256:00194b221ae87c76d82a8b4af5bdd89d49100bed78c6aa0df754a75de7733f8a","download_count":27850,"created_at":"2026-11-06T19:03:32Z","updated_at":"2026-11-06T19:03:43Z"},{"id":718224552,"node_id":"RA_kwDOLmfWBM4qzzyo","name":"zen.source.tar.zst","label":"","uploader":{"login":"mr-cheffy","id":91018726,"node_id":"U_kgDOBWzV5g","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1083589364,"digest":"sha256:f719e7db90bab2f209e5ac2896a77bcebdf74765ae02574e863e675ab4bdb1ec","download_count":356,"created_at":"2026-11-06T19:03:32Z","updated_at":"2026-11-06T19:04:12Z"}],"body":"# Zen Stable Release\n\n\n## Security\n- https://www.mozilla.org/en-US/security/advisories/mfsa2026-123/\n\n## New Features\n- Updated to Firefox 159.0.1\n- New grain options have been added to the theme picker. You can cycle through different grain effects by clicking on the circle inside the dial.\n\n## Fixes\n- Fixed a command prompt window briefly appearing on Windows when Zen restarts to apply an update.\n- Fixed passkey sign-in failing on websites that share passkeys across related sites, such as Facebook and Instagram.\n- Fixed crashes on Windows that could occur with some antivirus or other security software installed, in some cases also leaving WebGL disabled.\n- Fixed red and blue colors appearing swapped on some websites that use WebGL on Linux, including video call background effects.\n- More bug fixes and improvements.\n\n## Changes\n- On macOS, icons on the UI will now start using SF Symbols.\n- The 'About Zen' window has been redesigned.\n- 'My Review Request' option for Pull Requests live folder now searches for 'user-review-requested:@me' instead of 'review-requested:@me'\n","reactions":{"total_count":40,"+1":18,"-1":0,"laugh":0,"hooray":3,"confused":0,"heart":13,"rocket":6,"eyes":0},"mentions_count":1}
