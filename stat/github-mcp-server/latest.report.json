_at":"2026-10-06T23:28:07Z","updated_at":"2026-10-06T23:28:07Z"},{"id":616946990,"node_id":"RA_kwDOODGMVM4kxd0u","name":"github-mcp-server_Windows_i386.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":9126530,"digest":"sha256:470b9c6f302ff0d1102803cf93bc76eb7c39be15dd6e0859b97f65c33744bc08","download_count":4,"created_at":"2026-10-06T23:28:07Z","updated_at":"2026-10-06T23:28:07Z"},{"id":616947014,"node_id":"RA_kwDOODGMVM4kxd1G","name":"github-mcp-server_Windows_x86_64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":9428851,"digest":"sha256:ebd7647bed306481b84cec8597ac061b78be61ad04cc3b8851fb74dc387990b1","download_count":311,"created_at":"2026-10-06T23:28:08Z","updated_at":"2026-10-06T23:28:08Z"}],"body":"## Highlights :sparkles: \r\n\r\nMore and more agents are supporting *Code Mode* or *Programmatic Tool Calling* so we have added support for structured outputs and output schemas to help do this effectively.\r\n\r\nThese schemas are only advertised to clients advertising MCP 2026-07-28 spec support (or later). Our compound tools required some updates to allowed output schemas, so they are not valid for older clients and we don't return them.\r\n\r\n## What's Changed\r\n* perf: cache encoded tools/list schemas by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3407\r\n* Pin GitHub Actions to commit SHAs by @github-security-bot in https://github.com/github/github-mcp-server/pull/3259\r\n* feat(inventory): add typed MCP tool registration foundation by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3371\r\n* feat(context): add typed tool schemas and outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3377\r\n* feat(comments): add typed visibility tool inputs and outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3384\r\n* feat(search): add typed projected result outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3386\r\n* feat(security): add typed security alert outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3387\r\n* feat: type discussion and notification tool outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3388\r\n* feat(repos): add typed commit tool outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3389\r\n* feat(issues): add typed metadata, comment, and dependency outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3391\r\n* feat(repos): complete typed repository tool outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3392\r\n* feat(issues): add protocol-gated typed consolidated issue tools by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3393\r\n* Type granular issue MCP inputs and protocol-gated outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3394\r\n* refactor(search): type repository, user, org and commit search tools by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3395\r\n* refactor(pull-requests): migrate consolidated PR tools to typed inputs and outputs by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3396\r\n* refactor(pull-requests): type granular MCP tools by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3397\r\n* refactor(actions): type consolidated MCP tools by @SamMorrowDrums in https://github.com/github/github-mcp-server/pull/3398\r\n* Address typed output compatibility gaps by @kerobbi in https://github.com/github/github-mcp-server/pull/3433\r\n\r\n## New Contributors\r\n* @github-security-bot made their first contribution in https://github.com/github/github-mcp-server/pull/3259\r\n\r\n**Full Changelog**: https://github.com/github/github-mcp-server/compare/v1.14.0...v2.0.0","mentions_count":3}
