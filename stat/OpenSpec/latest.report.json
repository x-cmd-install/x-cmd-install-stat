":"2026-11-11T22:50:27Z","updated_at":"2026-11-11T22:50:29Z"},{"id":737187097,"node_id":"RA_kwDOPYoUTM4r8JUZ","name":"openspec-linux-arm64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":42312432,"digest":"sha256:c3f8313663f0a9ffe41c4df274b22398810f8685189713068ec80e574a325f5b","download_count":39,"created_at":"2026-11-11T22:50:27Z","updated_at":"2026-11-11T22:50:29Z"},{"id":737187100,"node_id":"RA_kwDOPYoUTM4r8JUc","name":"openspec-linux-x64-musl.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":39110818,"digest":"sha256:040b62a4a0ed8e64232613cc490463f66fe93e79247e0676653d894b7e5200c8","download_count":14,"created_at":"2026-11-11T22:50:27Z","updated_at":"2026-11-11T22:50:29Z"},{"id":737187174,"node_id":"RA_kwDOPYoUTM4r8JVm","name":"openspec-linux-x64.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":42521647,"digest":"sha256:de16fddbce121ee176e74c963a31dc723e851629a3b89a78bd16e360d34dcf4c","download_count":536,"created_at":"2026-11-11T22:50:29Z","updated_at":"2026-11-11T22:50:31Z"},{"id":737187177,"node_id":"RA_kwDOPYoUTM4r8JVp","name":"openspec-windows-arm64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":40453485,"digest":"sha256:c0593bc817879f212fee034751cec9e73d32daaa354954eaa42faa79bcd48958","download_count":11,"created_at":"2026-11-11T22:50:29Z","updated_at":"2026-11-11T22:50:31Z"},{"id":737187179,"node_id":"RA_kwDOPYoUTM4r8JVr","name":"openspec-windows-x64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":45145876,"digest":"sha256:4f50ca6765d7b7c214519558bf71635cc837f789155a42b21f73bbb6e11cb36b","download_count":565,"created_at":"2026-11-11T22:50:29Z","updated_at":"2026-11-11T22:50:31Z"},{"id":737187238,"node_id":"RA_kwDOPYoUTM4r8JWm","name":"SHA256SUMS","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":754,"digest":"sha256:26b8d826b1ebf0bef4f7eab0e403945d6f993e28a73238094e16cf35cad7903b","download_count":1451,"created_at":"2026-11-11T22:50:31Z","updated_at":"2026-11-11T22:50:32Z"}],"body":"# OpenSpec 2.0\n\nOpenSpec now installs skills in `.agents/skills/` instead of keeping a separate copy for each coding agent. Tools that don't read this folder, like Claude Code and Kiro, get links to the same skills.\n\nWe're also removing the `/opsx:*` slash commands. Each command already has a matching skill, so there's no need to maintain both.\n\nThe OpenSpec workflows themselves haven't changed.\n\n## What changed\n\n- **Skills are installed in `.agents/skills/`.** Every tool uses the same skills, without duplicate files across folders.\n- **`/opsx:*` commands are removed.** For example, `/opsx:propose` becomes `/openspec-propose` (or `$openspec-propose` in Codex). You can also just ask your agent for the work.\n- **`openspec update` removes files generated by older versions.** This includes old slash commands and duplicate skills. Files you've changed in the old locations are kept and listed.\n- The `delivery` setting is no longer needed. Existing configs keep working.\n- Amazon Q Developer support is removed because it can't load skills. We recommend Kiro instead.\n\n## How to upgrade\n\nUpdate the OpenSpec CLI, then run this in each project and commit the changes:\n\n```bash\nopenspec update\n```\n\nTo preview the changes first, run `openspec update --dry-run`.\n\n**Note:** if you edited OpenSpec's skills directly in `.agents/skills/`, `openspec update` overwrites those edits. Save them before upgrading.\n\nSee the [upgrade guide](https://openspec.dev/docs/upgrade-to-2) for more details.\n\n## Fixes\n\n- `openspec completion install` no longer edits PowerShell profiles when run from Windows cmd.exe.\n- `openspec instructions apply` no longer cuts off tasks that span several lines in `tasks.md`.\n\n**Full changelog:** [v1.17.0...v2.0.0](https://github.com/Fission-AI/OpenSpec/compare/v1.17.0...v2.0.0)\n","reactions":{"total_count":9,"+1":4,"-1":0,"laugh":0,"hooray":5,"confused":0,"heart":0,"rocket":0,"eyes":0}}
