OAhYdrs4uh8bD","name":"miller-6.23.0-windows-amd64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":6385262,"digest":"sha256:8192fbc5e959637f4112b34dcfdc518c1b59701bc34777ca528dc749ece15a1a","download_count":217,"created_at":"2026-11-22T22:21:17Z","updated_at":"2026-11-22T22:21:18Z"},{"id":780650018,"node_id":"RA_kwDOAhYdrs4uh8Yi","name":"miller-6.23.0-windows-arm64.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":5569207,"digest":"sha256:86a14238d63d441e10a1d979a882afc444eedc291f5c98d8650a8f9b40162cbc","download_count":24,"created_at":"2026-11-22T22:21:15Z","updated_at":"2026-11-22T22:21:16Z"},{"id":780661904,"node_id":"RA_kwDOAhYdrs4uh_SQ","name":"miller-6.23.0.tar.gz","label":"","uploader":{"login":"johnkerl","id":2008794,"node_id":"MDQ6VXNlcjIwMDg3OTQ=","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":3510427,"digest":"sha256:855b5c32798dffacc83f2c8da74abd1e9318571f8944c669e4003b5e2662a7e5","download_count":99,"created_at":"2026-11-22T22:25:38Z","updated_at":"2026-11-22T22:25:39Z"}],"body":"## Performance\r\n\r\n- Cached regexes are looked up before compiling in `regexpCompileCached`: https://github.com/johnkerl/miller/pull/2292\r\n- The CSV reader skips the per-field key lookup when the header has no duplicates: https://github.com/johnkerl/miller/pull/2291\r\n- The JSON writer skips the escape loop for strings that need no escapes: https://github.com/johnkerl/miller/pull/2321\r\n\r\n## Bug fixes\r\n\r\n### Input handling\r\n\r\n- UTF-8 BOM handling is fixed for gzipped CSV input: https://github.com/johnkerl/miller/pull/2278\r\n- A leading UTF-8 BOM is now stripped for TSV and CSV-lite: https://github.com/johnkerl/miller/pull/2281\r\n\r\n### Time and date functions\r\n\r\n- `fsec2hms` and `fsec2dhms` carry rounded fractional seconds correctly: https://github.com/johnkerl/miller/pull/2282\r\n- `strptime` and `gmt2sec` now work for dates outside the int64 nanosecond range: https://github.com/johnkerl/miller/pull/2285\r\n- File-backed `TZ` values are supported: https://github.com/johnkerl/miller/pull/2247\r\n\r\n### String functions\r\n\r\n- `strmatchx` reports starts and ends as UTF-8 character positions, not byte positions: https://github.com/johnkerl/miller/pull/2287\r\n  Follow-up docs and generated-file regeneration: https://github.com/johnkerl/miller/pull/2288\r\n\r\n### Number formatting\r\n\r\n- `fmtnum` now picks its formatter from the conversion verb, not from the end of the format string: https://github.com/johnkerl/miller/pull/2295\r\n  Follow-ups: https://github.com/johnkerl/miller/pull/2297\r\n- `fmtnum` and `--ofmt` accept the C verbs `%i`, `%u`, `%D` and `%U`: https://github.com/johnkerl/miller/pull/2298\r\n\r\n### Integer arithmetic\r\n\r\n- `int ** int` is computed exactly rather than through float64 where possible: https://github.com/johnkerl/miller/pull/2296\r\n  Extra unit-test cases (`5**0`, `MinInt64**1`): https://github.com/johnkerl/miller/pull/2299\r\n- Integer zero divisors no longer cause a panic in `./`, `madd`, `msub`, `mmul` and `mexp`: https://github.com/johnkerl/miller/pull/2300\r\n- `mexp` results are reduced for exponents 0 and 1: https://github.com/johnkerl/miller/pull/2301\r\n- `abs`, `ceil`, `floor`, `round` and `sgn` stay exact for ints above 2**53: https://github.com/johnkerl/miller/pull/2309\r\n- Unary minus of the minimum int, and `roundm` on large ints, are fixed: https://github.com/johnkerl/miller/pull/2311\r\n\r\n### Other\r\n\r\n- `arrayify` leaves its input unchanged: https://github.com/johnkerl/miller/pull/2317\r\n  Same for the `Mlrval.Arrayify` receiver: https://github.com/johnkerl/miller/pull/2320\r\n- On Windows under Git Bash or MSYS2, `sh` is now found on the `PATH`: https://github.com/johnkerl/miller/pull/2289\r\n- The `mand.mlr` magnitude calculation is fixed: https://github.com/johnkerl/miller/pull/2257\r\n\r\n## Documentation, build and release tooling\r\n\r\n- Doubled `cd` in the library-setup docs is fixed: https://github.com/johnkerl/miller/pull/2276\r\n- Prepipe commands that take flags are now quoted in help examples: https://github.com/johnkerl/miller/pull/2275\r\n- `LICENSE.txt` is identified as BSD-2-Clause for GitHub's licensee: https://github.com/johnkerl/miller/pull/2241\r\n- The releaser script uses Draft rather than Pre-release: https://github.com/johnkerl/miller/pull/2261\r\n- `make -C man build` fails when `groff` is missing or the manpage pipeline fails: https://github.com/johnkerl/miller/pull/2302\r\n  Regenerated with the new `groff` version: https://github.com/johnkerl/miller/pull/2303\r\n- `creach` is no longer used in docgen: https://github.com/johnkerl/miller/pull/2313\r\n- `~/.mlrrc` is suppressed in `make docs`: https://github.com/johnkerl/miller/pull/2316\r\n- Go version is now 1.26.10: https://github.com/johnkerl/miller/pull/2274\r\n- YAML dependency switched to `go.yaml.in/yaml/v3`: https://github.com/johnkerl/miller/pull/2319\r\n\r\n## Dependency bumps (Dependabot)\r\n\r\n- `github.com/klauspost/compress` 1.20.0 to 1.20.4: https://github.com/johnkerl/miller/pull/2258, https://github.com/johnkerl/miller/pull/2269, https://github.com/johnkerl/miller/pull/2304\r\n- `golang.org/x/term` 0.46.0 to 0.48.0: https://github.com/johnkerl/miller/pull/2264, https://github.com/johnkerl/miller/pull/2305\r\n- `golang.org/x/text` 0.42.0 to 0.44.0: https://github.com/johnkerl/miller/pull/2262, https://github.com/johnkerl/miller/pull/2306\r\n- `golang.org/x/sys` 0.49.0 to 0.50.0: https://github.com/johnkerl/miller/pull/2294\r\n- `pault.ag/go/debian` 0.21.0 to 0.21.4: https://github.com/johnkerl/miller/pull/2279, https://github.com/johnkerl/miller/pull/2284, https://github.com/johnkerl/miller/pull/2310\r\n- `github.com/lestrrat-go/strftime` 1.2.0 to 1.2.1: https://github.com/johnkerl/miller/pull/2283\r\n- `goreleaser/goreleaser-action` 7.2.3 to 7.3.0: https://github.com/johnkerl/miller/pull/2270\r\n- `actions/upload-artifact` 7.0.1 to 7.0.2: https://github.com/johnkerl/miller/pull/2266\r\n- `actions/setup-go` 7.0.0 to 7.1.0: https://github.com/johnkerl/miller/pull/2318\r\n- codeql-action group updates: https://github.com/johnkerl/miller/pull/2259, https://github.com/johnkerl/miller/pull/2265, https://github.com/johnkerl/miller/pull/2272, https://github.com/johnkerl/miller/pull/2280, https://github.com/johnkerl/miller/pull/2290, https://github.com/johnkerl/miller/pull/2293\r\n\r\n## New Contributors\r\n\r\n* @fzlzjerry made their first contribution in https://github.com/johnkerl/miller/pull/2247\r\n* @kvnloo made their first contribution in https://github.com/johnkerl/miller/pull/2241\r\n* @dcadolph made their first contribution in https://github.com/johnkerl/miller/pull/2276\r\n* @Boulea7 made their first contribution in https://github.com/johnkerl/miller/pull/2278\r\n* @youdie006 made their first contribution in https://github.com/johnkerl/miller/pull/2281\r\n* @ChandraChaan made their first contribution in https://github.com/johnkerl/miller/pull/2282\r\n* @shaurya703 made their first contribution in https://github.com/johnkerl/miller/pull/2285\r\n* @b84330808 made their first contribution in https://github.com/johnkerl/miller/pull/2287\r\n* @ptweezy made their first contribution in https://github.com/johnkerl/miller/pull/2292\r\n* @g4lb made their first contribution in https://github.com/johnkerl/miller/pull/2291\r\n* @waw666waw666 made their first contribution in https://github.com/johnkerl/miller/pull/2295\r\n* @Kernel-Hunter made their first contribution in https://github.com/johnkerl/miller/pull/2296\r\n\r\n**Full Changelog**: https://github.com/johnkerl/miller/compare/v6.22.0...v6.23.0\r\n","reactions":{"total_count":4,"+1":4,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"mentions_count":12}
