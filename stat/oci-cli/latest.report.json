-11-18T10:58:44Z"},{"id":763039728,"node_id":"RA_kwDOBFcSgc4tew_w","name":"oci-cli-3.96.3-Windows-Server-2019-Offline.zip","label":"","uploader":{"login":"oci-dex-release-bot","id":95374885,"node_id":"U_kgDOBa9OJQ","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":60529865,"digest":"sha256:3cc82ba65d3cd53d4e43da6f16e03c4e07eeb86f22439117d65c56742f16a163","download_count":10,"created_at":"2026-11-18T10:58:36Z","updated_at":"2026-11-18T10:58:39Z"},{"id":763039856,"node_id":"RA_kwDOBFcSgc4texBw","name":"oci-cli-3.96.3-Windows-Server-Installer.msi","label":"","uploader":{"login":"oci-dex-release-bot","id":95374885,"node_id":"U_kgDOBa9OJQ","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":40194048,"digest":"sha256:e361ce8ba547e647bbc675a4ed9f1b2d5b129876fd9435c5adbd851ac7b6ff27","download_count":525,"created_at":"2026-11-18T10:58:39Z","updated_at":"2026-11-18T10:58:41Z"},{"id":758270329,"node_id":"RA_kwDOBFcSgc4tMkl5","name":"oci-cli-3.96.3.zip","label":"","uploader":{"login":"oci-dex-release-bot","id":95374885,"node_id":"U_kgDOBa9OJQ","gravatar_id":"","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":134746051,"digest":"sha256:c9acb3c0340f4b250ddd76f536622ae2c08402097a155569d6a3e1cb1cb3ac0c","download_count":154,"created_at":"2026-11-17T08:35:43Z","updated_at":"2026-11-17T08:35:49Z"}],"body":"\n## Added\n* Support for new optional parameter ``--ssl-inspection-configuration`` in Database service\n* Support for new optional parameters ``--is-dynamic-backend-weight-enabled`` and ``--default-weight`` in the Load Balancer service.\n  * ``oci lb health-checker update --is-dynamic-backend-weight-enabled``\n  * ``oci lb health-checker update --default-weight``\n* Support for new optional parameter ``--tiering-configuration`` for object tiering in the Lustre File service\n  * ``oci lfs lustre-file-system create --tiering-configuration``\n  * ``oci lfs lustre-file-system update --tiering-configuration``\n* Oracle Cloud VMware Solution service\n  * Support for new command\n    * ``oci ocvs sddc retrieve-sddc-operation-status``\n  * Support for new optional parameter ``--capacity-reservation-id``\n    * ``oci ocvs esxi-host replace-host --capacity-reservation-id``\n    * ``oci ocvs esxi-host inplace-upgrade --capacity-reservation-id``\n  * Support for new optional parameter ``--vmware-software-version``\n    * ``oci ocvs esxi-host update --vmware-software-version``\n  * Support for new optional parameter ``--esxi-software-version``\n    * ``oci ocvs esxi-host update --esxi-software-version``\n  * ``--compartment-id | -c`` is now an optional parameter for ``oci ocvs datastore list`` and ``oci ocvs datastore-cluster list``\n\n## File Checksums (SHA256)\noci-cli-3.96.3.zip c9acb3c0340f4b250ddd76f536622ae2c08402097a155569d6a3e1cb1cb3ac0c\noci-cli-3.96.3-Oracle-Linux-9-Offline.zip 895a4cbcabf56becae48580a4a7445eb07824f9c1e56f915f2451bc7e231e886\noci-cli-3.96.3-Ubuntu-20.04-Offline.zip d1f7f2eafbcffc5a11429b0d6ae3a9d26a5e18cd3024488563235eb62cf3aa3c\noci-cli-3.96.3-Windows-Server-2019-Offline.zip 3cc82ba65d3cd53d4e43da6f16e03c4e07eeb86f22439117d65c56742f16a163\noci-cli-3.96.3-Windows-Server-Installer.msi e361ce8ba547e647bbc675a4ed9f1b2d5b129876fd9435c5adbd851ac7b6ff27\noci-cli-3.96.3-Windows-Server-2016-Offline.zip ad1d577225dbf6357c0f5ee19f3b03294fda60f0b6fe2fa686482b0a5f74dfcc\noci-cli-3.96.3-Oracle-Linux-10-Offline.zip b47faa7dc0b913c663e98827f8080796365226436bf409ea2a78ba665fe66edd\noci-cli-3.96.3-Ubuntu-26.04-Offline.zip 095a6806112ec4e618874ce92b509e09dc57980d88c6af67dcf9c09a77b8c200\noci-cli-3.96.3-Ubuntu-22.04-Offline.zip 9821c41ebc4b6a86934e150335a826f25a5aa1287076aaaa8687e8a2bd506d15\noci-cli-3.96.3-Oracle-Linux-8-Offline.zip 28fc853257458029989766f371359e4f6b6be3feaf3af2051a9e4fd2b8e2ee8e"}
