8ab68ea03c9798ba35aa981079","download_count":1,"created_at":"2026-10-30T14:58:52Z","updated_at":"2026-10-30T14:58:53Z"},{"id":692449651,"node_id":"RA_kwDOJibVLc4pRfFz","name":"quivr-tei.spdx.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":2848567,"digest":"sha256:745c790fa8c48b8f9e84b5617e9531b0ea125dfa1cbf06d06a846896a1d2ea0d","download_count":1,"created_at":"2026-10-30T14:58:52Z","updated_at":"2026-10-30T14:58:53Z"},{"id":692449653,"node_id":"RA_kwDOJibVLc4pRfF1","name":"quivr-web.spdx.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":2935416,"digest":"sha256:d0a5c929e4442e4bd0a8401441f08f0c8cc9b8481d18219b6220eebbf3496f49","download_count":1,"created_at":"2026-10-30T14:58:52Z","updated_at":"2026-10-30T14:58:53Z"},{"id":692449669,"node_id":"RA_kwDOJibVLc4pRfGF","name":"quivr.spdx.json","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":115294,"digest":"sha256:fe739eccb3c0fcc5f74934dd2ed1ade140962ac8c9572c347d982ae84b9e32db","download_count":1,"created_at":"2026-10-30T14:58:53Z","updated_at":"2026-10-30T14:58:53Z"}],"body":"## Quivr 2.0.2\n\n2.0.2 moves the search database to Weaviate 1.39.14. It changes no API, no configuration and no stored data. Upgrade any 2.0.x installation to it.\n\n### What Weaviate 1.39.14 fixes for Quivr\n\n- **Filtered searches no longer fail at random.** Quivr filters every vector and hybrid search to the scope of the request. Weaviate's default filtering strategy could crash such a search on a node of the vector graph with more links than expected, and the search then returned an error.\n- **Security:** CVE-2026-63209, in the compression library.\n- **Less memory.**\n  - Quivr compresses its vectors. Compressed indexes now drop the uncompressed vector cache they no longer use, which can save gigabytes on a large index.\n  - Weaviate also stops keeping memory it never frees when writing to its in-memory tables.\n- **Safer restarts.** A crash right after a shutdown could leave a keyword-search file empty, and the database would then not start without a manual repair. Startup and shutdown are also faster.\n\nResults do not change. The hybrid search changes in 1.39.14 only affect `offset` paging and `nearText` queries, and Quivr uses neither.\n\n### Upgrade from 2.0.0 or 2.0.1\n\n1. Back up the search database volume.\n2. Deploy the 2.0.2 images and the new Weaviate pin from `deploy/infrastructure.json`, or the 2.0.2 compose bundle attached to this release for a single machine.\n3. Keep the same Weaviate volume.\n\nThis is a patch upgrade within one Weaviate minor version: no re-indexing and no Quivr migration. The test that upgrades a 1.37.15 volume through 1.38.20 to 1.39.14, then checks lexical, semantic and hybrid search, passes on this release.\n\nThe release images are signed and carry SBOMs, as described in [Security of Quivr releases](https://docs.quivr.thevibecompany.co/run-quivr/security).\n\n---\n\n## [2.0.2](https://github.com/The-Vibe-Company/quivr/compare/v2.0.1...v2.0.2) (2026-10-30)\n\n\n### Bug Fixes\n\n* **deploy:** pin Weaviate 1.39.14 for filtered-search panics and RQ memory ([#3976](https://github.com/The-Vibe-Company/quivr/issues/3976)) ([90d7d88](https://github.com/The-Vibe-Company/quivr/commit/90d7d88e3f4287a0fa648834dbc1546ae2569cd4))\n\n"}
