d":493009196,"node_id":"RA_kwDORNfGD84dYrks","name":"sha256sums.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain","state":"uploaded","size":675,"digest":"sha256:68fc9cf9c232ca935e8c152aa9d5caf41843cadccb9270b368f2108038d06979","download_count":228,"created_at":"2026-07-28T17:48:58Z","updated_at":"2026-07-28T17:48:59Z"}],"body":"## Changelog\n\n**Full Changelog**: https://github.com/Bengerthelorf/pikpaktui/compare/v0.0.57...v0.0.58\n\n### Changes since v0.0.57:\n\n#### Features\n- feat(tui): add discoverable actions menu (0d4b953)\n- feat(tui): make modal lists mouse-selectable (ab002cb)\n- feat(tui): surface recent operation status (b2385c0)\n- feat(tui): adapt layouts to narrow terminals (1cbec46)\n- feat(tui): add cursor-aware text editing (b92a6c4)\n\n#### Bug Fixes\n- fix(tui): guard unsaved settings changes (47ee365)\n\n#### Other\n- test(tui): keep mouse tests after runtime code (2acef40)\n\n<details><summary>Maintenance</summary>\n\n- docs(tui): document responsive interactions (34a3e3c)\n- chore(release): bump version to 0.0.58 (f9cefca)\n\n</details>\n\n\n## Download\nChoose the appropriate binary for your platform:\n- **Linux x86_64**: pikpaktui-x86_64-linux.tar.gz (statically linked)\n- **Linux ARM64**: pikpaktui-aarch64-linux.tar.gz (statically linked)\n- **macOS Intel**: pikpaktui-x86_64-macos.tar.gz\n- **macOS Apple Silicon**: pikpaktui-aarch64-macos.tar.gz\n- **Windows x86_64**: pikpaktui-x86_64-windows.zip\n- **Windows ARM64**: pikpaktui-aarch64-windows.zip\n- **FreeBSD x86_64**: pikpaktui-x86_64-freebsd.tar.gz\n"}
