:29,"created_at":"2026-11-01T21:48:31Z","updated_at":"2026-11-01T21:48:32Z"},{"id":699619782,"node_id":"RA_kwDOUD3FGM4ps1nG","name":"streamtop-x86_64-apple-darwin.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":6395382,"digest":"sha256:0e13382aa32e343f362dda4ef15392ae0974a052a4e2d524824975ce984eb0da","download_count":4,"created_at":"2026-11-01T21:48:32Z","updated_at":"2026-11-01T21:48:32Z"},{"id":699619797,"node_id":"RA_kwDOUD3FGM4ps1nV","name":"streamtop-x86_64-pc-windows-msvc.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":5555800,"digest":"sha256:ffbc271023016a67900e19ffbf222aa7b910b6f1938295b63b72ae2ca4f336f0","download_count":7,"created_at":"2026-11-01T21:48:32Z","updated_at":"2026-11-01T21:48:32Z"},{"id":699619799,"node_id":"RA_kwDOUD3FGM4ps1nX","name":"streamtop-x86_64-unknown-linux-gnu.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":6827158,"digest":"sha256:ba15f109f57e687392360575ebe3afa3608182191339f19bd1a8c0bb30671cf8","download_count":13,"created_at":"2026-11-01T21:48:32Z","updated_at":"2026-11-01T21:48:32Z"},{"id":699619806,"node_id":"RA_kwDOUD3FGM4ps1ne","name":"streamtop-x86_64-unknown-linux-musl.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":7169701,"digest":"sha256:5270c848ee8e5b3a8e5b6d3ce9c8763dbb179a8a1dc3e4b3199e78bc6e2fa43d","download_count":3,"created_at":"2026-11-01T21:48:32Z","updated_at":"2026-11-01T21:48:33Z"}],"body":"# streamtop v1.7.1\n\n### Changed\n\n- `streamtop check` and `--audit` report a reachable on-demand entry as `VOD` instead of `LIVE`. The JSON report has a new `vod` count; VOD entries count as working for `--fail-on-dead` and `--alive-out`.\n- The `check` table header prints the capture time in whole seconds (UTC).\n\n### Fixed\n\n- `cargo install streamtop` from crates.io failed to compile: the reqwest `http3` feature needs `--cfg reqwest_unstable`, which was only set in the repository's `.cargo/config.toml` and is not read for registry installs. The feature is removed. reqwest 0.12 only uses HTTP/3 with prior knowledge, which streamtop never enabled, so connections were HTTP/1.1 or HTTP/2 before and after this change.\n- `SHA256SUMS` lists bare file names, so `sha256sum -c` works in the download directory (the v1.7.0 file was replaced with the corrected one).\n- `streamtop completions` and `streamtop man` no longer panic or print an error when stdout is closed early (for example `| head`).\n\n\n## Install\n\n```bash\ncargo install streamtop --version 1.7.1\n```\n\nGitHub Release binaries attached below.\n"}
