application/x-gtar","state":"uploaded","size":3522617,"digest":"sha256:237538cdc97d5c1803e8a5d20fffeab6f02c36435e831a23c57e4990f62d2409","download_count":20,"created_at":"2026-09-30T09:13:16Z","updated_at":"2026-09-30T09:13:17Z"},{"id":600500151,"node_id":"RA_kwDOOYmpSM4jyue3","name":"mdns-scanner-x86_64-unknown-linux-musl.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":112,"digest":"sha256:932a870456c6f291dddb9c7eba77ea7593d9fa59758161d17fcc9adbb1348db7","download_count":0,"created_at":"2026-09-30T09:13:16Z","updated_at":"2026-09-30T09:13:16Z"},{"id":600500156,"node_id":"RA_kwDOOYmpSM4jyue8","name":"mdns-scanner.rb","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-ruby","state":"uploaded","size":3099,"digest":"sha256:bc24af3cfaa7b692f5f227e0c6c8da7ab18a879936709573db092dfb15bc285b","download_count":0,"created_at":"2026-09-30T09:13:16Z","updated_at":"2026-09-30T09:13:17Z"},{"id":600500162,"node_id":"RA_kwDOOYmpSM4jyufC","name":"sha256.sum","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":81,"digest":"sha256:eb73dc7599adc37378ca5f26413774a4de093c3f800e4a6740aea93abd9e23d5","download_count":0,"created_at":"2026-09-30T09:13:16Z","updated_at":"2026-09-30T09:13:17Z"},{"id":600500166,"node_id":"RA_kwDOOYmpSM4jyufG","name":"source.tar.gz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":6249183,"digest":"sha256:14bc12aba48dc3cedd28470a9902a7fc2bb03a1196b61a69a12a37e5cdc65518","download_count":0,"created_at":"2026-09-30T09:13:17Z","updated_at":"2026-09-30T09:13:17Z"},{"id":600500170,"node_id":"RA_kwDOOYmpSM4jyufK","name":"source.tar.gz.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":81,"digest":"sha256:eb73dc7599adc37378ca5f26413774a4de093c3f800e4a6740aea93abd9e23d5","download_count":0,"created_at":"2026-09-30T09:13:17Z","updated_at":"2026-09-30T09:13:17Z"}],"body":"## Release Notes\n\n### Fixed\n\n- Join the mDNS multicast group for DNS-SD discovery so responses sent to `224.0.0.251:5353` are received, as required by [RFC 6762 5.2](https://www.rfc-editor.org/rfc/rfc6762.html#section-5.2) ([#315](https://github.com/CramBL/mdns-scanner/issues/315)).\n- Ignore Known Answers in mDNS query packets during DNS-SD discovery, as required by [RFC 6762 7.1](https://www.rfc-editor.org/rfc/rfc6762.html#section-7.1); [18.2](https://www.rfc-editor.org/rfc/rfc6762.html#section-18.2) defines the query/response bit ([#316](https://github.com/CramBL/mdns-scanner/issues/316)).\n- Ignore mDNS responses from UDP source ports other than 5353 or with a non-zero OPCODE, as required by [RFC 6762 6](https://www.rfc-editor.org/rfc/rfc6762.html#section-6) and [18.3](https://www.rfc-editor.org/rfc/rfc6762.html#section-18.3) ([#317](https://github.com/CramBL/mdns-scanner/issues/317)).\n- Correct IPv4 host counts and scanning ranges, including `/0`, `/31`, and `/32` networks, [RFC 3021 2.1](https://www.rfc-editor.org/rfc/rfc3021.html#section-2.1) treats both `/31` addresses as hosts on point-to-point links ([#321](https://github.com/CramBL/mdns-scanner/issues/321)).\n- DNS-SD service-type enumeration now recognizes PTR owner names regardless of letter case, as required by [RFC 1035 2.3.3](https://www.rfc-editor.org/rfc/rfc1035.html#section-2.3.3) ([#320](https://github.com/CramBL/mdns-scanner/issues/320)).\n\n### Dependencies\n\n- `dns-lookup`: 3.0.1 → 4.0.1 ([#314](https://github.com/CramBL/mdns-scanner/pull/314))\n- `dirs`: 6.0.0 → 7.0.0 ([#314](https://github.com/CramBL/mdns-scanner/pull/314))\n- `rstest`: 0.26.1 → 0.27.0 ([#314](https://github.com/CramBL/mdns-scanner/pull/314))\n\n## Install mdns-scanner 1.0.1\n\n### Install prebuilt binaries via shell script\n\n```sh\ncurl --proto '=https' --tlsv1.2 -LsSf https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-installer.sh | sh\n```\n\n### Install prebuilt binaries via powershell script\n\n```sh\npowershell -ExecutionPolicy Bypass -c \"irm https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-installer.ps1 | iex\"\n```\n\n### Install prebuilt binaries via Homebrew\n\n```sh\nbrew install CramBL/tap/mdns-scanner\n```\n\n## Download mdns-scanner 1.0.1\n\n|  File  | Platform | Checksum |\n|--------|----------|----------|\n| [mdns-scanner-aarch64-apple-darwin.tar.gz](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-aarch64-apple-darwin.tar.gz) | Apple Silicon macOS | [checksum](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-aarch64-apple-darwin.tar.gz.sha256) |\n| [mdns-scanner-x86_64-apple-darwin.tar.gz](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-x86_64-apple-darwin.tar.gz) | Intel macOS | [checksum](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-x86_64-apple-darwin.tar.gz.sha256) |\n| [mdns-scanner-aarch64-pc-windows-msvc.zip](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-aarch64-pc-windows-msvc.zip) | ARM64 Windows | [checksum](https://github.com/CramBL/mdns-scanner/releases/download/v1.0.1/mdns-scanner-aarch64-pc-windows-msvc.zip.sha256) |\n