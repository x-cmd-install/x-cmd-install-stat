6-c4rx52B","name":"hyperframes-lambda-handler.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":97,"digest":"sha256:dc832964a3d850d8ec49ebaf8c5da0dc35db857b87f29a97f64baf1f4cb48188","download_count":0,"created_at":"2026-11-11T07:00:24Z","updated_at":"2026-11-11T07:00:24Z"},{"id":734502274,"node_id":"RA_kwDORi26-c4rx52C","name":"hyperframes-lambda-handler.zip","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":129968873,"digest":"sha256:d0b1120ed44a3b2d8453a2a69494ebfe45e6e4d3b0fc3c1983747cfbfab9bf52","download_count":0,"created_at":"2026-11-11T07:00:24Z","updated_at":"2026-11-11T07:00:29Z"},{"id":734502613,"node_id":"RA_kwDORi26-c4rx57V","name":"hyperframes-lambda-video-arm64.oci.tar","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/x-tar","state":"uploaded","size":245353984,"digest":"sha256:680ad430223dd1e663b352f522a2cee16764fd1ddf04598c7e1d46bbcc212f0c","download_count":0,"created_at":"2026-11-11T07:00:30Z","updated_at":"2026-11-11T07:00:47Z"},{"id":734502611,"node_id":"RA_kwDORi26-c4rx57T","name":"hyperframes-lambda-video-arm64.sha256","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","gravatar_id":"","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":105,"digest":"sha256:60fe2ebc9a64f7fd90b4ba2868121592cd197462ffb01fd072b691b5a6f8ae07","download_count":0,"created_at":"2026-11-11T07:00:30Z","updated_at":"2026-11-11T07:00:30Z"}],"body":"# HyperFrames v0.9.33\n\nReleased on 2026-11-11.\n\nClips that start partway into a voice recording now keep their sound to the end, even when the WAV file misreports its own byte rate. Variable-bound media also renders at the right length and loudness.\n\n## Fixes\n\n- **Engine:** A clip that starts partway into a WAV whose header gives the wrong byte rate now plays the right sound to its end, instead of going quiet early or staying silent ([7ae1ae649](https://github.com/heygen-com/hyperframes/commit/7ae1ae64942f036a18c546bef024121d8df76ef2), [#7541](https://github.com/heygen-com/hyperframes/pull/7541)).\n- **Share:** When you reach the hourly limit on review versions, the message now explains that limit ([8a15d9fee](https://github.com/heygen-com/hyperframes/commit/8a15d9feedc62dc9695246dceda9271a6d0a08e9), [#7539](https://github.com/heygen-com/hyperframes/pull/7539)).\n- **Projects:** A composition can only look up files inside its own project folder ([5a88c9938](https://github.com/heygen-com/hyperframes/commit/5a88c9938edaf464f7953e762bb40f604623f1b1), [#7534](https://github.com/heygen-com/hyperframes/pull/7534)).\n- **Capture:** A wrong captioning region or model name is reported before captioning starts ([bcc1437d7](https://github.com/heygen-com/hyperframes/commit/bcc1437d77f592d33b794b5544ae98bb3647c6ad), [#7533](https://github.com/heygen-com/hyperframes/pull/7533)).\n- **Producer:** A video or sound set through a variable now renders at its clip's length and loudness ([789d28121](https://github.com/heygen-com/hyperframes/commit/789d28121183f72976834d3693329e956f88de88), [#7529](https://github.com/heygen-com/hyperframes/pull/7529)).\n\n## Docs & Examples\n\n- **Variables:** Say what can be a variable, including a video or sound per account ([28d69d9a9](https://github.com/heygen-com/hyperframes/commit/28d69d9a94c13b2b39e99d207c2ee595b59781c9), [#7530](https://github.com/heygen-com/hyperframes/pull/7530)).\n\n## Internal\n\n- **CLI:** Give each test file its own home so renders never wait on another file's lock ([2b86c49dc](https://github.com/heygen-com/hyperframes/commit/2b86c49dc2cb067051eca1ccf9d0b1d22054719a), [#7526](https://github.com/heygen-com/hyperframes/pull/7526)).\n\n## Full changelog\n\nhttps://github.com/heygen-com/hyperframes/compare/v0.9.32...v0.9.33\n"}
